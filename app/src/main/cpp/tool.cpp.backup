#ifndef NO_CURL
// 回调函数用于接收HTTP响应数据
static size_t WriteCallback(void *contents, size_t size, size_t nmemb, std::string *userp) {
    size_t totalSize = size * nmemb;
    userp->append((char*)contents, totalSize);
    return totalSize;
}

// 执行HTTP GET请求
std::string performHttpGet(const std::string& url) {
    CURL *curl;
    CURLcode res;
    std::string readBuffer;

    curl = curl_easy_init();
    if(curl) {
        curl_easy_setopt(curl, CURLOPT_URL, url.c_str());
        
        // 提取并保存域名
        g_extractedDomain = extractDomainFromUrl(url);
        LOGD("提取的域名: %s", g_extractedDomain.c_str());
        
        // 🔒 关键安全检查：请求前验证域名
        if (!verifyDomainIntegrity()) {
            LOGE("🚨 HTTP GET请求前域名验证失败！检测到域名篡改");
            LOGE("程序将在3秒后安全退出...");
            std::this_thread::sleep_for(std::chrono::seconds(3));
            std::exit(1);
        }
        
        curl_easy_setopt(curl, CURLOPT_WRITEFUNCTION, WriteCallback);
        curl_easy_setopt(curl, CURLOPT_WRITEDATA, &readBuffer);
        curl_easy_setopt(curl, CURLOPT_TIMEOUT, 30L);
        curl_easy_setopt(curl, CURLOPT_FOLLOWLOCATION, 1L);
        
        res = curl_easy_perform(curl);
        
        // 🔒 请求后再次验证域名
        if (!verifyDomainIntegrity()) {
            LOGE("🚨 HTTP GET请求后域名验证失败！检测到域名篡改");
            std::exit(1);
        }
        
        if(res != CURLE_OK) {
            LOGE("curl_easy_perform() failed: %s", curl_easy_strerror(res));
            readBuffer = "Error: " + std::string(curl_easy_strerror(res));
        }
        
        curl_easy_cleanup(curl);
    } else {
        LOGE("Failed to initialize curl");
        readBuffer = "Error: Failed to initialize curl";
    }
    
    return readBuffer;
}

#ifndef NO_OPENSSL
// AES加密函数
std::string encryptDomainWithAES(const std::string& domain) {
    // 固定的AES密钥和IV（实际应用中应该使用更安全的方式生成）
    std::string keyStr = KEYHTTP;
    std::string ivStr = IVHTTP;
    
    unsigned char key[32];
    unsigned char iv[16];
    
    // 先清零数组，确保未使用的字节为0
    memset(key, 0, sizeof(key));
    memset(iv, 0, sizeof(iv));
    
    // 复制密钥和IV数据，确保长度正确
    size_t keyLen = std::min(keyStr.length(), (size_t)32);
    size_t ivLen = std::min(ivStr.length(), (size_t)16);
    
    memcpy(key, keyStr.c_str(), keyLen);
    memcpy(iv, ivStr.c_str(), ivLen);
    
    LOGD("域名加密 - 密钥长度: %zu, IV长度: %zu", keyLen, ivLen);
    LOGD("域名加密 - 密钥: %s", keyStr.c_str());
    LOGD("域名加密 - IV: %s", ivStr.c_str());
    
    EVP_CIPHER_CTX *ctx = EVP_CIPHER_CTX_new();
    if (!ctx) {
        LOGE("Failed to create cipher context");
        return "";
    }
    
    // 初始化加密操作
    if (EVP_EncryptInit_ex(ctx, EVP_aes_256_cbc(), NULL, key, iv) != 1) {
        LOGE("Failed to initialize encryption");
        EVP_CIPHER_CTX_free(ctx);
        return "";
    }
    
    // 准备输出缓冲区
    int len;
    int ciphertext_len;
    unsigned char ciphertext[1024];
    
    // 加密数据
    if (EVP_EncryptUpdate(ctx, ciphertext, &len, (unsigned char*)domain.c_str(), domain.length()) != 1) {
        LOGE("Failed to encrypt data");
        EVP_CIPHER_CTX_free(ctx);
        return "";
    }
    ciphertext_len = len;
    
    // 完成加密
    if (EVP_EncryptFinal_ex(ctx, ciphertext + len, &len) != 1) {
        LOGE("Failed to finalize encryption");
        EVP_CIPHER_CTX_free(ctx);
        return "";
    }
    ciphertext_len += len;
    
    EVP_CIPHER_CTX_free(ctx);
    
    // 将加密结果转换为十六进制字符串
    std::string encrypted_hex;
    for (int i = 0; i < ciphertext_len; i++) {
        char hex[3];
        snprintf(hex, sizeof(hex), "%02x", ciphertext[i]);
        encrypted_hex += hex;
    }
    
    return encrypted_hex;
}

// 生成随机字符串（字母和数字组合）
std::string generateRandomString(int length) {
    // 添加输入参数验证
    if (length <= 0 || length > 1024) {
        LOGE("generateRandomString: 无效的长度参数: %d", length);
        return "";
    }
    
    std::string charsetStr = generateRandomString1;
    
    // 🚨 关键安全检查：防止空指针和空字符串
    if (charsetStr.empty()) {
        LOGE("generateRandomString: 字符集字符串为空，使用备用字符集");
        charsetStr = "abcdefghijklmnopqrstuvwxyz123456789"; // 备用字符集
    }
    
    const char* charset = charsetStr.c_str();
    if (charset == nullptr) {
        LOGE("generateRandomString: 字符集指针为空，使用备用字符集");
        charsetStr = "abcdefghijklmnopqrstuvwxyz123456789";
        charset = charsetStr.c_str();
    }
    
    size_t charsetLen = charsetStr.length();
    if (charsetLen == 0) {
        LOGE("generateRandomString: 字符集长度为0，使用备用字符集");
        charsetStr = "abcdefghijklmnopqrstuvwxyz123456789";
        charset = charsetStr.c_str();
        charsetLen = charsetStr.length();
    }
    
    std::string result;
    result.reserve(length);
    
    // 使用智能指针替代原始指针，确保异常安全
    try {
        auto random_bytes = std::make_unique<unsigned char[]>(length);
        if (random_bytes == nullptr) {
            LOGE("generateRandomString: 内存分配失败，使用时间戳种子");
            goto fallback_random;
        }
        
        if (RAND_bytes(random_bytes.get(), length) != 1) {
            LOGE("generateRandomString: OpenSSL随机数生成失败，使用备用方法");
            goto fallback_random;
        }
        
        for (int i = 0; i < length; ++i) {
            result += charset[random_bytes[i] % charsetLen];
        }
        
        LOGD("generateRandomString: OpenSSL生成成功，长度: %d", length);
        return result;
        
    } catch (const std::exception& e) {
        LOGE("generateRandomString: 异常: %s，使用备用方法", e.what());
        goto fallback_random;
    } catch (...) {
        LOGE("generateRandomString: 未知异常，使用备用方法");
        goto fallback_random;
    }

fallback_random:
    // 备用随机数生成方法
    try {
        result.clear();
        result.reserve(length);
        
        // 使用时间戳作为种子
        srand(time(nullptr) + std::hash<std::thread::id>{}(std::this_thread::get_id()));
        
        for (int i = 0; i < length; ++i) {
            result += charset[rand() % charsetLen];
        }
        
        LOGD("generateRandomString: 备用方法生成成功，长度: %d", length);
        return result;
        
    } catch (const std::exception& e) {
        LOGE("generateRandomString: 备用方法异常: %s", e.what());
        return "error" + std::to_string(time(nullptr) % 100000); // 最后的应急方案
    } catch (...) {
        LOGE("generateRandomString: 备用方法未知异常");
        return "error" + std::to_string(time(nullptr) % 100000);
    }
}

// AES加密POST数据
std::string encryptPostDataWithAES(const std::string& postData) {
    // 随机生成16字节的key和iv（字母和数字组合）
    std::string keyStr = generateRandomString(16);
    std::string ivStr = generateRandomString(16);
    
    LOGD("生成的加密key: %s", keyStr.c_str());
    LOGD("生成的加密iv: %s", ivStr.c_str());
    LOGD("输入POST数据长度: %zu", postData.length());
    LOGD("输入POST数据前100字符: %.100s", postData.c_str());
    LOGD("输入POST数据后100字符: %s", postData.length() > 100 ? postData.substr(postData.length() - 100).c_str() : "N/A");
    
    unsigned char key[16];
    unsigned char iv[16];
    memcpy(key, keyStr.c_str(), 16);
    memcpy(iv, ivStr.c_str(), 16);
    
    EVP_CIPHER_CTX *ctx = EVP_CIPHER_CTX_new();
    if (!ctx) {
        LOGE("Failed to create cipher context for POST data");
        return "";
    }
    
    // 初始化加密操作（使用AES-128-CBC）
    if (EVP_EncryptInit_ex(ctx, EVP_aes_128_cbc(), NULL, key, iv) != 1) {
        LOGE("Failed to initialize POST data encryption");
        EVP_CIPHER_CTX_free(ctx);
        return "";
    }
    
    // 动态分配输出缓冲区，确保足够大以容纳长签名数据
    // AES-CBC需要额外的padding，所以分配输入长度+16字节的空间，再加上额外的安全边界
    int max_ciphertext_len = postData.length() + 32; // 16字节padding + 16字节安全边界
    if (max_ciphertext_len < 4096) {
        max_ciphertext_len = 4096; // 最小4KB缓冲区
    }
    
    std::vector<unsigned char> ciphertext(max_ciphertext_len);
    int len;
    int ciphertext_len;
    
    LOGD("POST数据原始长度: %zu, 分配缓冲区大小: %d", postData.length(), max_ciphertext_len);
    
    // 加密数据
    if (EVP_EncryptUpdate(ctx, ciphertext.data(), &len, (unsigned char*)postData.c_str(), postData.length()) != 1) {
        LOGE("Failed to encrypt POST data");
        EVP_CIPHER_CTX_free(ctx);
        return "";
    }
    ciphertext_len = len;
    
    // 完成加密
    if (EVP_EncryptFinal_ex(ctx, ciphertext.data() + len, &len) != 1) {
        LOGE("Failed to finalize POST data encryption");
        EVP_CIPHER_CTX_free(ctx);
        return "";
    }
    ciphertext_len += len;
    
    EVP_CIPHER_CTX_free(ctx);
    
    LOGD("加密完成，实际密文长度: %d", ciphertext_len);
    
    // 将加密结果转换为十六进制字符串
    std::string encrypted_hex;
    encrypted_hex.reserve(ciphertext_len * 2); // 预分配空间提高性能
    for (int i = 0; i < ciphertext_len; i++) {
        char hex[3];
        snprintf(hex, sizeof(hex), "%02x", ciphertext[i]);
        encrypted_hex += hex;
    }
    
    LOGD("加密后的POST数据十六进制长度: %zu", encrypted_hex.length());
    
    // 按照要求组合数据：key放在第44个字符后，iv放到倒数第11个字符之前
    std::string result;
    
    // 确保加密数据长度足够
    if (encrypted_hex.length() < 55) {
        // 如果加密数据太短，填充到足够长度
        while (encrypted_hex.length() < 80) {
            encrypted_hex += "00";
        }
    }
    
    // 构建最终数据：前18个字符 + key + 中间部分 + iv + 最后13个字符
    std::string front = encrypted_hex.substr(0, 18);  // 前18个字符
    std::string middle = encrypted_hex.substr(18, encrypted_hex.length() - 31);  // 中间部分
    std::string back = encrypted_hex.substr(encrypted_hex.length() - 13);  // 最后13个字符
    
    result = front + keyStr + middle + ivStr + back;
    
    // 组合成{msg:数据}格式
    std::string finalResult = std::string("{\"") + MSG + "\":\"" + result + "\"}";
    
    LOGD("最终加密POST数据长度: %zu", finalResult.length());
    LOGD("最终加密POST数据前100字符: %.100s", finalResult.c_str());
    LOGD("最终加密POST数据后100字符: %s", finalResult.length() > 100 ? finalResult.substr(finalResult.length() - 100).c_str() : "N/A");
    
    return finalResult;
}

// AES解密POST数据
std::string decryptPostDataWithAES(const std::string& encryptedData) {
    // 解析JSON格式的加密数据
    std::string msgData;
    size_t msgStart = encryptedData.find(std::string("\"") + MSG + "\":\"");
    if (msgStart == std::string::npos) {
        LOGE("Invalid encrypted data format - no msg field");
        return "";
    }
    msgStart += 7; // 跳过 "msg":"
    size_t msgEnd = encryptedData.find("\"", msgStart);
    if (msgEnd == std::string::npos) {
        LOGE("Invalid encrypted data format - no closing quote");
        return "";
    }
    msgData = encryptedData.substr(msgStart, msgEnd - msgStart);
    
    LOGD("提取的加密数据: %s", msgData.c_str());
    
    // 确保数据长度足够
    if (msgData.length() < 55) {
        LOGE("Encrypted data too short: %d", (int)msgData.length());
        return "";
    }
    
    // 按照加密时的格式解析：前18个字符 + key(16) + 中间部分 + iv(16) + 最后13个字符
    std::string front = msgData.substr(0, 18);  // 前18个字符
    std::string keyStr = msgData.substr(18, 16);  // key
    std::string back13 = msgData.substr(msgData.length() - 13);  // 最后13个字符
    std::string ivStr = msgData.substr(msgData.length() - 29, 16);  // iv在倒数第29到第13个字符
    std::string middle = msgData.substr(34, msgData.length() - 63);  // 修正：中间部分长度应为总长-63
    
    LOGD("解析的key: %s", keyStr.c_str());
    LOGD("解析的iv: %s", ivStr.c_str());
    
    // 重构原始加密数据（不包含key和iv）
    std::string encrypted_hex = front + middle + back13;
    
    LOGD("重构的加密数据: %s", encrypted_hex.c_str());
    
    // 将十六进制字符串转换为字节数组
    std::vector<unsigned char> ciphertext;
    for (size_t i = 0; i < encrypted_hex.length(); i += 2) {
        if (i + 1 < encrypted_hex.length()) {
            std::string byteString = encrypted_hex.substr(i, 2);
            unsigned char byte = (unsigned char)strtol(byteString.c_str(), NULL, 16);
            ciphertext.push_back(byte);
        }
    }
    
    // 准备key和iv
    unsigned char key[16];
    unsigned char iv[16];
    memcpy(key, keyStr.c_str(), 16);
    memcpy(iv, ivStr.c_str(), 16);
    
    EVP_CIPHER_CTX *ctx = EVP_CIPHER_CTX_new();
    if (!ctx) {
        LOGE("Failed to create cipher context for decryption");
        return "";
    }
    
    // 初始化解密操作（使用AES-128-CBC）
    if (EVP_DecryptInit_ex(ctx, EVP_aes_128_cbc(), NULL, key, iv) != 1) {
        LOGE("Failed to initialize decryption");
        EVP_CIPHER_CTX_free(ctx);
        return "";
    }
    
    // 动态分配输出缓冲区，确保足够大以容纳解密后的数据
    int max_plaintext_len = ciphertext.size() + 32; // 额外的安全边界
    if (max_plaintext_len < 4096) {
        max_plaintext_len = 4096; // 最小4KB缓冲区
    }
    
    std::vector<unsigned char> plaintext(max_plaintext_len);
    int len;
    int plaintext_len;
    
    LOGD("密文长度: %zu, 分配解密缓冲区大小: %d", ciphertext.size(), max_plaintext_len);
    
    // 解密数据
    if (EVP_DecryptUpdate(ctx, plaintext.data(), &len, ciphertext.data(), ciphertext.size()) != 1) {
        LOGE("Failed to decrypt data");
        EVP_CIPHER_CTX_free(ctx);
        return "";
    }
    plaintext_len = len;
    
    // 完成解密
    if (EVP_DecryptFinal_ex(ctx, plaintext.data() + len, &len) != 1) {
        LOGE("Failed to finalize decryption");
        EVP_CIPHER_CTX_free(ctx);
        return "";
    }
    plaintext_len += len;
    
    EVP_CIPHER_CTX_free(ctx);
    
    // 转换为字符串
    std::string result((char*)plaintext.data(), plaintext_len);
    
    LOGD("解密成功，原始数据长度: %d", plaintext_len);
    
    return result;
}
#endif

// 执行HTTP POST请求
std::string performHttpPost(const std::string& url, const std::string& postData, long* outResponseCode, bool encrypt) {
    CURL *curl;
    CURLcode res;
    std::string readBuffer;
    long response_code = 0;
    std::string sendData = postData;
    int retry_count = 0;
    const int max_retries = 2; // 最大重试次数

#ifndef NO_OPENSSL
    if (encrypt) {
        sendData = encryptPostDataWithAES(postData);
        LOGD("POST数据已加密，长度: %zu", sendData.length());
    }
#else
    if (encrypt) {
        LOGW("请求加密但OpenSSL未启用，发送明文");
    }
#endif

    // 重试循环
    while (retry_count <= max_retries) {
        curl = curl_easy_init();
        if(curl) {
            curl_easy_setopt(curl, CURLOPT_URL, url.c_str());
            
            // 提取并保存域名（修复域名为空的问题）
            g_extractedDomain = extractDomainFromUrl(url);
            LOGD("POST请求提取的域名: %s", g_extractedDomain.c_str());
            
            // 🔒 关键安全检查：POST请求前验证域名
            if (!verifyDomainIntegrity()) {
                LOGE("🚨 HTTP POST请求前域名验证失败！检测到域名篡改");
                LOGE("程序将在3秒后安全退出...");
                std::this_thread::sleep_for(std::chrono::seconds(3));
                std::exit(1);
            }
            
            curl_easy_setopt(curl, CURLOPT_WRITEFUNCTION, WriteCallback);
            curl_easy_setopt(curl, CURLOPT_WRITEDATA, &readBuffer);
            
            // 优化超时设置
            curl_easy_setopt(curl, CURLOPT_TIMEOUT, 15L);           // 总超时15秒
            curl_easy_setopt(curl, CURLOPT_CONNECTTIMEOUT, 5L);     // 连接超时5秒
            curl_easy_setopt(curl, CURLOPT_LOW_SPEED_LIMIT, 1024L); // 最低速度1KB/s
            curl_easy_setopt(curl, CURLOPT_LOW_SPEED_TIME, 10L);    // 低速度超时10秒
            
            curl_easy_setopt(curl, CURLOPT_FOLLOWLOCATION, 1L);
            curl_easy_setopt(curl, CURLOPT_MAXREDIRS, 3L);          // 最大重定向3次
            curl_easy_setopt(curl, CURLOPT_PROXY, "");
            
            // 设置HTTP头
            struct curl_slist *headers = NULL;
            headers = curl_slist_append(headers, HTTP_HEAD);
            curl_easy_setopt(curl, CURLOPT_HTTPHEADER, headers);
            curl_easy_setopt(curl, CURLOPT_POSTFIELDS, sendData.c_str());
            curl_easy_setopt(curl, CURLOPT_POSTFIELDSIZE, sendData.length());
            
            // 执行请求
            res = curl_easy_perform(curl);
            verifyDomainIntegrity();
            
            if(res != CURLE_OK) {
                LOGW("curl_easy_perform() 失败 (尝试 %d/%d): %s", retry_count + 1, max_retries + 1, curl_easy_strerror(res));
                
                // 清理当前curl会话
                curl_slist_free_all(headers);
                curl_easy_cleanup(curl);
                
                // 检查是否应该重试
                if (retry_count < max_retries && 
                    (res == CURLE_OPERATION_TIMEDOUT || res == CURLE_COULDNT_CONNECT || 
                     res == CURLE_RECV_ERROR || res == CURLE_SEND_ERROR)) {
                    retry_count++;
                    LOGI("网络错误，%d秒后重试...", retry_count * 2);
                    std::this_thread::sleep_for(std::chrono::seconds(retry_count * 2));
                    readBuffer.clear(); // 清空之前的错误响应
                    continue;
                } else {
                    readBuffer = "Error: " + std::string(curl_easy_strerror(res));
                    break;
                }
            } else {
                curl_easy_getinfo(curl, CURLINFO_RESPONSE_CODE, &response_code);
                LOGD("HTTP response code: %ld (尝试 %d/%d)", response_code, retry_count + 1, max_retries + 1);
                LOGD("Response data: %s", readBuffer.c_str());
                
                curl_slist_free_all(headers);
                curl_easy_cleanup(curl);
                break; // 成功，退出重试循环
            }
        } else {
            LOGE("Failed to initialize curl");
            readBuffer = CURL_REEOR;
            break;
        }
    }
    
    if (outResponseCode) *outResponseCode = response_code;
    return readBuffer;
}

// 简单的Unicode转义解码函数
std::string decodeUnicodeEscapes(const std::string& str) {
    std::string result = str;
    size_t pos = 0;
    
    while ((pos = result.find("\\u", pos)) != std::string::npos) {
        if (pos + 6 <= result.length()) {
            std::string hexStr = result.substr(pos + 2, 4);
            try {
                // 将十六进制字符串转换为整数
                int codePoint = std::stoi(hexStr, nullptr, 16);
                
                // 简单的UTF-8编码（仅处理基本多文种平面）
                std::string utf8Char;
                if (codePoint <= 0x7F) {
                    utf8Char = static_cast<char>(codePoint);
                } else if (codePoint <= 0x7FF) {
                    utf8Char += static_cast<char>(0xC0 | (codePoint >> 6));
                    utf8Char += static_cast<char>(0x80 | (codePoint & 0x3F));
                } else {
                    utf8Char += static_cast<char>(0xE0 | (codePoint >> 12));
                    utf8Char += static_cast<char>(0x80 | ((codePoint >> 6) & 0x3F));
                    utf8Char += static_cast<char>(0x80 | (codePoint & 0x3F));
                }
                
                result.replace(pos, 6, utf8Char);
                pos += utf8Char.length();
            } catch (...) {
                pos += 6; // 跳过无效的转义序列
            }
        } else {
            break;
        }
    }
    
    return result;
}

// 简单的JSON解析函数，提取login字段的值
std::string extractLoginFromJson(const std::string& jsonStr) {
    // 查找"login":"值"
    std::string loginKey = std::string("\"") + HTTP_TEXT_LOGIN + "\":\"";
    size_t startPos = jsonStr.find(loginKey);
    if (startPos == std::string::npos) {
        return "";
    }
    
    startPos += loginKey.length();
    size_t endPos = jsonStr.find("\"", startPos);
    if (endPos == std::string::npos) {
        return "";
    }
    
    std::string rawValue = jsonStr.substr(startPos, endPos - startPos);
    // 解码Unicode转义序列
    return decodeUnicodeEscapes(rawValue);
}

// 从login字段中提取到期时间
std::string extractExpiryTime(const std::string& loginValue) {
    // 查找"到期时间:"后面的时间
    std::string timePrefix = EXPIRY_TIME_PREFIX;
    size_t timePos = loginValue.find(timePrefix);
    if (timePos != std::string::npos) {
        std::string timeStr = loginValue.substr(timePos + timePrefix.length());
        // 去除前后空格
        size_t start = timeStr.find_first_not_of(" \t");
        if (start != std::string::npos) {
            size_t end = timeStr.find_last_not_of(" \t");
            return timeStr.substr(start, end - start + 1);
        }
    }
    return "";
}

// 构建POST表单数据
std::string buildFormData(const std::string& token, const std::string& licenseKey, 
                         const std::string& deviceId, const std::string& canshu) {
    // 使用动态获取的应用名称作为表名
    std::string tableName = getAppName();
    LOGD("buildFormData: 使用表名: %s", tableName.c_str());
    
    // 参数验证（基于PHP后端验证逻辑）
    if (!ValidationUtils::validateParameters(tableName, licenseKey, deviceId, token)) {
        LOGE("buildFormData: 参数验证失败");
        return "";
    }
    
    // 验证canshu参数
    if (!ValidationUtils::validateCanshu(canshu)) {
        LOGE("buildFormData: canshu参数无效: %s", canshu.c_str());
        return "";
    }
    
    // 记录脱敏后的参数信息
    std::string filteredInfo = ValidationUtils::filterSensitiveData(licenseKey, deviceId);
    LOGD("buildFormData: 构建表单数据 - %s, canshu:%s", filteredInfo.c_str(), canshu.c_str());
    
    std::ostringstream formData;
    formData << std::string(HTTP_PARAM_TB) + "=" << tableName
             << "&" + std::string(HTTP_PARAM_CDK) + "=" << licenseKey
             << "&" + std::string(HTTP_PARAM_IMEI) + "=" << deviceId
             << "&" + std::string(HTTP_PARAM_TOK) + "=" << token
             << "&" + std::string(HTTP_PARAM_CANSHU) + "=" << canshu;
    
    std::string result = formData.str();
    LOGD("buildFormData: 表单数据构建成功，长度: %zu", result.length());
    
    return result;
}

// 生成时间戳哈希token
std::string generateTimestampHash() {
    auto now = std::chrono::system_clock::now();
    auto timestamp = std::chrono::duration_cast<std::chrono::milliseconds>(now.time_since_epoch()).count();
    return std::to_string(timestamp);
}

// 生成UUID字符串（标准36位格式：xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx）
std::string generateUUID() {
    // 获取当前时间戳（用于随机种子）
    auto now = std::chrono::system_clock::now();
    auto timestamp = std::chrono::duration_cast<std::chrono::microseconds>(now.time_since_epoch()).count();
    
    // 使用时间戳作为随机种子
    srand(static_cast<unsigned int>(timestamp));
    
    // 生成标准UUID格式：xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
    std::stringstream uuid;
    
    // 第一部分：8位十六进制字符
    for (int i = 0; i < 8; i++) {
        uuid << std::hex << (rand() % 16);
    }
    uuid << "-";
    
    // 第二部分：4位十六进制字符
    for (int i = 0; i < 4; i++) {
        uuid << std::hex << (rand() % 16);
    }
    uuid << "-";
    
    // 第三部分：4位十六进制字符（版本位设为4）
    uuid << "4"; // UUID版本4
    for (int i = 0; i < 3; i++) {
        uuid << std::hex << (rand() % 16);
    }
    uuid << "-";
    
    // 第四部分：4位十六进制字符（变体位）
    int variant = (rand() % 4) + 8; // 确保变体位正确（8、9、A、B）
    uuid << std::hex << variant;
    for (int i = 0; i < 3; i++) {
        uuid << std::hex << (rand() % 16);
    }
    uuid << "-";
    
    // 第五部分：12位十六进制字符
    for (int i = 0; i < 12; i++) {
        uuid << std::hex << (rand() % 16);
    }
    
    std::string result = uuid.str();
    
    // 验证生成的UUID长度
    if (result.length() != 36) {
        LOGE("generateUUID: 生成的UUID长度错误 - 期望36位，实际%zu位: %s", result.length(), result.c_str());
        // 如果长度不对，生成一个备用的固定格式UUID
        result = "12345678-1234-4567-89ab-123456789012";
    }
    
    LOGD("generateUUID: 生成36位UUID: %s", result.c_str());
    return result;
}

// 创建目录
bool createDirectory(const std::string& path) {
    LOGD("createDirectory: 尝试创建目录: %s", path.c_str());
    
    if (path.empty()) {
        LOGE("createDirectory: 路径为空");
        return false;
    }
    
    // 检查目录是否已存在
    if (directoryExists(path)) {
        LOGD("createDirectory: 目录已存在: %s", path.c_str());
        return true;
    }
    
    // 使用系统调用创建目录
    std::string command = "mkdir -p \"" + path + "\"";
    int result = system(command.c_str());
    
    if (result == 0) {
        LOGD("createDirectory: 目录创建成功: %s", path.c_str());
        return true;
    } else {
        LOGE("createDirectory: 目录创建失败: %s, 错误码: %d", path.c_str(), result);
        
        // 尝试使用Android API创建目录
        #ifdef __ANDROID__
        // 在Android上，我们可以尝试使用更直接的方法
        // 这里可以添加Android特定的目录创建逻辑
        LOGW("createDirectory: 尝试备用方法创建目录");
        #endif
        
        return false;
    }
}

// 从文件读取设备ID
std::string readDeviceIdFromFile(const std::string& filePath) {
    try {
        std::ifstream file(filePath);
        if (!file.is_open()) {
            LOGD("无法打开设备ID文件: %s", filePath.c_str());
            return "";
        }
        
        std::string deviceId;
        if (std::getline(file, deviceId)) {
            // 移除可能的换行符和空格
            deviceId.erase(std::remove_if(deviceId.begin(), deviceId.end(), ::isspace), deviceId.end());
            LOGD("从文件读取设备ID成功: %s", filePath.c_str());
            return deviceId;
        } else {
            LOGW("设备ID文件为空或无法读取: %s", filePath.c_str());
            return "";
        }
    } catch (const std::exception& e) {
        LOGE("读取设备ID文件异常: %s, 文件: %s", e.what(), filePath.c_str());
        return "";
    } catch (...) {
        LOGE("读取设备ID文件未知异常, 文件: %s", filePath.c_str());
        return "";
    }
}

// 保存设备ID到文件
bool saveDeviceIdToFile(const std::string& deviceId) {
    LOGD("saveDeviceIdToFile: 开始保存设备ID到文件: %s", DEVICE_ID_FILE_PATH.c_str());
    
    // 创建目录（如果不存在）
    if (!createDirectory(STORAGE_PATH_DOCUMENTS)) {
        LOGE("saveDeviceIdToFile: 无法创建设备ID目录: %s", STORAGE_PATH_DOCUMENTS);
        return false;
    }
    
    try {
        std::ofstream file(DEVICE_ID_FILE_PATH);
        if (!file.is_open()) {
            LOGE("saveDeviceIdToFile: 无法创建或打开设备ID文件: %s", DEVICE_ID_FILE_PATH.c_str());
            return false;
        }
        
        file << deviceId;
        
        if (file.fail()) {
            LOGE("saveDeviceIdToFile: 写入设备ID失败");
            return false;
        }
        
        LOGD("saveDeviceIdToFile: 设备ID保存成功");
        return true;
    } catch (const std::exception& e) {
        LOGE("saveDeviceIdToFile: 保存设备ID异常: %s", e.what());
        return false;
    } catch (...) {
        LOGE("saveDeviceIdToFile: 保存设备ID未知异常");
        return false;
    }
}

// 获取设备ID（按照Java层getAndroidId逻辑实现）
std::string getDeviceId() {
    LOGD("C++层获取Android ID");
    std::string deviceId = "";
    
    try {
        // 从文件读取已保存的设备ID
        deviceId = readDeviceIdFromFile(DEVICE_ID_FILE_PATH);
        if (!deviceId.empty()) {
            LOGD("getDeviceId: 从文件读取ID成功");
            return deviceId;
        }
        
        // 如果文件不存在或为空，生成新的UUID
        deviceId = generateUUID();
        LOGD("getDeviceId: 生成新的UUID");
        
        // 保存设备ID到文件
        if (!saveDeviceIdToFile(deviceId)) {
            LOGW("getDeviceId: 保存设备ID到文件失败，但继续使用生成的ID");
        }
        
    } catch (const std::exception& e) {
        LOGE("getDeviceId: 获取设备ID异常: %s", e.what());
        
        // 异常处理：尝试从文件读取之前保存的ID
        deviceId = readDeviceIdFromFile(DEVICE_ID_FILE_PATH);
        if (deviceId.empty()) {
            deviceId = generateUUID();
            LOGD("getDeviceId: 异常处理 - 生成随机UUID");
            saveDeviceIdToFile(deviceId);
        } else {
            LOGD("getDeviceId: 异常处理 - 从文件读取ID成功");
        }
    }
    
    LOGD("getDeviceId: 最终返回ID: %s", deviceId.substr(0, 8).c_str());
    return deviceId;
}

