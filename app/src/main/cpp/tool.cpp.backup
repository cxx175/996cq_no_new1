// 提取域名的函数
std::string extractDomainFromUrl(const std::string& url) {
    std::string domain = "";
    
    // 查找协议分隔符
    size_t protocolEnd = url.find("://");
    if (protocolEnd != std::string::npos) {
        // 跳过协议部分
        size_t domainStart = protocolEnd + 3;
        size_t domainEnd = url.find("/", domainStart);
        
        if (domainEnd != std::string::npos) {
            domain = url.substr(domainStart, domainEnd - domainStart);
        } else {
            domain = url.substr(domainStart);
        }
    } else {
        // 没有协议，直接查找第一个斜杠
        size_t domainEnd = url.find("/");
        if (domainEnd != std::string::npos) {
            domain = url.substr(0, domainEnd);
        } else {
            domain = url;
        }
    }
    
    return domain;
}

