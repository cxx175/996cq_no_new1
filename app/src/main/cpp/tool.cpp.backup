// 多线程心跳验证相关全局变量
static std::atomic<bool> heartbeatRunning{false};
static std::shared_ptr<std::thread> heartbeatThread;
static std::mutex heartbeatMutex;
static std::string globalToken;
static std::string globalLicenseKey;
static std::string globalDeviceId;

// API3.0卡密验证相关全局变量
static std::string globalNeedle;  // 存储登录后的needle标识
static std::string globalClientKey;  // 存储登录时的client_key
static std::string globalSign;  // 存储登录时的sign
static std::string globalTimestamp;  // 存储登录时的timestamp
static std::string globalDeviceIdForLogin;  // 存储登录时的device_id

// 启动持续心跳验证
void startContinuousHeartbeat(JNIEnv* env, jobject context, const std::string& token, const std::string& licenseKey, const std::string& deviceId, int intervalSeconds) {
    std::lock_guard<std::mutex> lock(heartbeatMutex);
    
    // 如果已经在运行，先停止
    if (heartbeatRunning.load()) {
        LOGW("心跳验证已在运行，先停止当前心跳");
        stopContinuousHeartbeat();
    }
    
    // 保存参数
    globalToken = token;
    globalLicenseKey = licenseKey;
    globalDeviceId = deviceId;
    
    // 设置运行标志
    heartbeatRunning.store(true);
    
    LOGI("启动持续心跳验证，间隔: %d秒", intervalSeconds);
    
    // 🎯 启动Hook系统
    LOGI("🎯 心跳启动时同时启动Hook系统");
    try {
        autoInitializeHooks();
        LOGI("✅ Hook系统启动成功");
    } catch (const std::exception& e) {
        LOGE("❌ Hook系统启动失败: %s", e.what());
    }
    
    // 新增：导出SharedPreferences为JSON
    startDemoConvertPrefsToJsonLoop(env, context);
    // 启动心跳线程
    heartbeatThread = std::make_shared<std::thread>([intervalSeconds]() {
        LOGI("心跳验证线程已启动");
        
        while (heartbeatRunning.load()) {
            // 执行心跳验证
            std::string result = sendHeartbeat(globalToken, globalLicenseKey, globalDeviceId);
            
            if (result.find("SUCCESS:") == 0) {
                LOGI("持续心跳验证成功");
            } else {
                LOGE("心跳验证失败，程序即将退出: %s", result.c_str());
                
                // 心跳验证失败，直接退出应用
                heartbeatRunning.store(false);
                cleanupOnAppExit();
                exit(1);
                return;
            }
            // 等待指定间隔时间，支持中断
            for (int i = 0; i < intervalSeconds && heartbeatRunning.load(); ++i) {
                std::this_thread::sleep_for(std::chrono::seconds(1));
            }
        }
        
        LOGI("心跳验证线程已停止");
    });
}

// 停止持续心跳验证
void stopContinuousHeartbeat() {
    LOGI("停止持续心跳验证");
    heartbeatRunning.store(false);
    
    // 🛑 停止Hook系统
    LOGI("🛑 心跳停止时同时停止Hook系统");
    try {
        stopAllContinuousHookInstall();
        LOGI("✅ Hook系统停止成功");
    } catch (const std::exception& e) {
        LOGE("❌ Hook系统停止失败: %s", e.what());
    }
    
    // 正确等待线程结束
    if (heartbeatThread && heartbeatThread->joinable()) {
        LOGI("等待心跳线程结束...");
        heartbeatThread->join();
        LOGI("心跳线程已安全结束");
    }
    
    // 重置线程指针
    heartbeatThread.reset();
}

// 检查心跳是否正在运行
bool isHeartbeatRunning() {
    return heartbeatRunning.load();
}

// 应用退出清理函数
void cleanupOnAppExit() {
    LOGI("开始应用退出清理...");
    
    // 停止心跳验证
    if (isHeartbeatRunning()) {
        LOGI("停止心跳验证线程");
        stopContinuousHeartbeat();
    }
    
    // 🧹 清理Hook系统
    LOGI("🧹 应用退出时清理Hook系统");
    try {
        cleanupHooksOnExit();
        LOGI("✅ Hook系统清理完成");
    } catch (const std::exception& e) {
        LOGE("❌ Hook系统清理失败: %s", e.what());
    }
    
    // 清理全局字符串变量，释放内存
    {
        std::lock_guard<std::mutex> lock(heartbeatMutex);
        globalToken.clear();
        globalLicenseKey.clear();
        globalDeviceId.clear();
        globalToken.shrink_to_fit();
        globalLicenseKey.shrink_to_fit();
        globalDeviceId.shrink_to_fit();
    }
    
    
#ifndef NO_CURL
    // 清理curl全局状态
    curl_global_cleanup();
#endif
    
    LOGI("应用退出清理完成");
}

// 登录验证并启动持续心跳的统一接口
std::string verifyLicenseWithContinuousHeartbeat(JNIEnv* env, jobject context, const std::string& licenseKey) {
    LOGI("开始卡密验证与持续心跳 (API3.0)");
    
    // 使用新的API3.0卡密登录接口
    std::string result = cardLogin(licenseKey);
    
    if (result.find("SUCCESS:") == 0) {
        LOGI("卡密验证成功，启动持续心跳验证");
        
        // 解析返回结果，提取到期时间和needle
        std::string resultData = result.substr(8); // 移除"SUCCESS:"前缀
        
        // 从字符串末尾查找最后一个冒号，正确分割到期时间和needle
        size_t lastColonPos = resultData.rfind(":");
        if (lastColonPos != std::string::npos) {
            std::string expiryTime = resultData.substr(0, lastColonPos);
            globalNeedle = resultData.substr(lastColonPos + 1);
            
            LOGI("提取到期时间: %s, needle: %s", expiryTime.c_str(), globalNeedle.c_str());
            
            // 保存到期时间到全局变量
            saveExpiryTime(expiryTime);
            
            // 启动持续心跳验证（间隔30秒）
            startContinuousHeartbeat(env, context, "", licenseKey, "", 30);
            
            return "SUCCESS:" + expiryTime;
        } else {
            // 兼容旧格式（没有needle）
            saveExpiryTime(resultData);
            startContinuousHeartbeat(env, context, "", licenseKey, "", 30);
            return result;
        }
    } else {
        LOGE("卡密验证失败: %s", result.c_str());
        return result;
    }
}

// 发送心跳包 (API3.0)
std::string sendHeartbeat(const std::string& token, const std::string& licenseKey, const std::string& deviceId) {
    LOGD("发送卡密心跳验证请求 (API3.0)...");
    
    // 使用新的API3.0卡密心跳接口
    // 使用保存的全局needle标识
    std::string needle = globalNeedle;
    
    if (needle.empty()) {
        LOGW("needle标识为空，使用本地时间比较判断是否到期");
        
        // 使用本地时间比较
        if (isExpiredByLocalTime()) {
            LOGE("本地时间比较：授权已过期");
            return "1"; // 过期
        } else {
            LOGI("本地时间比较：授权未过期，心跳验证通过");
            std::string savedTime = getSavedExpiryTime();
            
            // 计算剩余时间并显示
            std::time_t currentTime = std::time(nullptr);
            std::time_t expiryTimestamp = parseTimeString(savedTime);
            if (expiryTimestamp != -1) {
                std::string remainingTime = formatTimeDifference(currentTime, expiryTimestamp);
                LOGI("剩余有效时间: %s", remainingTime.c_str());
            }
            
            return "SUCCESS:" + savedTime;
        }
    }
    
    if (globalLicenseKey.empty()) {
        LOGE("sendHeartbeat: 全局卡密为空，无法执行心跳");
        return "Error: 心跳参数错误";
    }

    // 使用新的API3.0心跳接口
    std::string result = cardHeartbeat(globalLicenseKey, needle);
    
    if (result.find("SUCCESS:") == 0) {
        LOGI("卡密心跳验证成功");
        return result;
    } else {
        LOGE("卡密心跳验证失败: %s", result.c_str());
        return "1"; // 过期
    }
    
#else
    return "1";
#endif
}

// 检查目录是否存在
bool directoryExists(const std::string& path) {
    struct stat info;
    if (stat(path.c_str(), &info) != 0) {
        return false; // 路径不存在
    }
    return (info.st_mode & S_IFDIR) != 0; // 检查是否为目录
}

// 复制文件
bool copyFile(const std::string& sourcePath, const std::string& targetPath) {
    LOGD("copyFile: 开始复制文件从 %s 到 %s", sourcePath.c_str(), targetPath.c_str());
    
    try {
        std::ifstream source(sourcePath, std::ios::binary);
        if (!source.is_open()) {
            LOGE("copyFile: 无法打开源文件: %s", sourcePath.c_str());
            return false;
        }
        
        std::ofstream target(targetPath, std::ios::binary);
        if (!target.is_open()) {
            LOGE("copyFile: 无法创建目标文件: %s", targetPath.c_str());
            return false;
        }
        
        // 使用流操作符进行复制，更安全且自动处理缓冲
        target << source.rdbuf();
        
        // 检查操作是否成功
        if (source.bad() || target.bad()) {
            LOGE("copyFile: 文件复制过程中出错");
            return false;
        }
        
        LOGD("copyFile: 文件复制成功");
        return true;
    } catch (const std::exception& e) {
        LOGE("copyFile: 文件复制异常: %s", e.what());
        return false;
    } catch (...) {
        LOGE("copyFile: 文件复制未知异常");
        return false;
    }
}

// 复制目录及其内容
bool copyDirectory(const std::string& sourcePath, const std::string& targetPath) {
    LOGD("copyDirectory: 开始复制目录从 %s 到 %s", sourcePath.c_str(), targetPath.c_str());
    
    if (!directoryExists(sourcePath)) {
        LOGE("copyDirectory: 源目录不存在: %s", sourcePath.c_str());
        return false;
    }
    
    // 创建目标目录
    if (!createDirectory(targetPath)) {
        LOGE("copyDirectory: 无法创建目标目录: %s", targetPath.c_str());
        return false;
    }
    
    DIR* dir = opendir(sourcePath.c_str());
    if (!dir) {
        LOGE("copyDirectory: 无法打开源目录: %s", sourcePath.c_str());
        return false;
    }
    
    struct dirent* entry;
    bool success = true;
    
    while ((entry = readdir(dir)) != nullptr && success) {
        std::string name = entry->d_name;
        
        // 跳过 "." 和 ".." 目录
        if (name == "." || name == "..") {
            continue;
        }
        
        std::string sourceItem = sourcePath + "/" + name;
        std::string targetItem = targetPath + "/" + name;
        
        struct stat itemStat;
        if (stat(sourceItem.c_str(), &itemStat) == 0) {
            if (S_ISDIR(itemStat.st_mode)) {
                // 递归复制子目录
                success = copyDirectory(sourceItem, targetItem);
            } else {
                // 复制文件
                success = copyFile(sourceItem, targetItem);
            }
        } else {
            LOGE("copyDirectory: 无法获取文件状态: %s", sourceItem.c_str());
            success = false;
        }
    }
    
    closedir(dir);
    
    if (success) {
        LOGD("copyDirectory: 目录复制成功");
    } else {
        LOGE("copyDirectory: 目录复制失败");
    }
    
    return success;
}



// 新增：基于PHP后端验证逻辑的参数验证函数
namespace ValidationUtils {
    
    /**
     * 验证表名格式（基于PHP后端的validateTableName逻辑）
     * @param tableName 表名
     * @return bool 是否有效
     */
    bool validateTableName(const std::string& tableName) {
        if (tableName.empty()) {
            LOGW("表名验证：表名为空");
            return false;
        }
        LOGD("表名验证：动态验证通过");
        return true;
    }
    
    /**
     * 验证CDK格式（基于PHP后端的validateCDK逻辑）
     * @param cdk 注册码
     * @return bool 是否有效
     */
    bool validateCDK(const std::string& cdk) {
        if (cdk.empty()) {
            LOGW("CDK验证：注册码为空");
            return false;
        }
        
        LOGD("CDK验证：格式验证通过");
        return true;
    }
    
    /**
     * 验证IMEI格式（基于PHP后端的validateIMEI逻辑）
     * @param imei 设备IMEI
     * @return bool 是否有效
     */
    bool validateIMEI(const std::string& deviceId) {
        if (deviceId.empty()) {
            LOGW("设备ID验证：设备ID为空");
            return false;
        }
        
        // 检查是否为36位UUID格式（xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx）
        if (deviceId.length() == 36) {
            // 验证UUID格式：8-4-4-4-12，包含4个连字符
            if (deviceId[8] == '-' && deviceId[13] == '-' && 
                deviceId[18] == '-' && deviceId[23] == '-') {
                LOGD("设备ID验证：36位UUID格式验证通过");
                return true;
            } else {
                LOGW("设备ID验证：36位长度但连字符位置不正确");
                return false;
            }
        }
        
        // 如果不是36位，可能是传统IMEI或其他格式，进行基本验证
        if (deviceId.length() >= 8) {
            LOGD("设备ID验证：传统格式验证通过");
            return true;
        }
        
        LOGW("设备ID验证：格式无效，长度: %zu", deviceId.length());
        return false;
    }
    
    /**
     * 验证参数完整性
     * @param table 表名
     * @param cdk 注册码
     * @param deviceId 设备ID
     * @param token 令牌
     * @return bool 是否完整
     */
    bool validateParameters(const std::string& table, const std::string& cdk, 
                          const std::string& deviceId, const std::string& token) {
        if (table.empty() || cdk.empty() || deviceId.empty()) {
            LOGW("参数验证：必要参数为空 - table:%s, cdk:%s, deviceId:%s", 
                 table.empty() ? "空" : "有值",
                 cdk.empty() ? "空" : "有值", 
                 deviceId.empty() ? "空" : "有值");
            return false;
        }
        
        // 验证表名格式
        if (!validateTableName(table)) {
            LOGW("参数验证：表名格式无效: %s", table.c_str());
            return false;
        }
        
        // 验证CDK格式
        if (!validateCDK(cdk)) {
            LOGW("参数验证：CDK格式无效: %s", cdk.substr(0, 4).c_str());
            return false;
        }
        
        // 验证设备ID格式
        if (!validateIMEI(deviceId)) {
            LOGW("参数验证：设备ID格式无效: %s", deviceId.substr(0, 4).c_str());
            return false;
        }
        
        // 验证token不为空（可选验证）
        if (token.empty()) {
            LOGW("参数验证：token为空");
            return false;
        }
        
        LOGD("参数验证：所有参数验证通过");
        return true;
    }
    
    /**
     * 过滤敏感信息用于日志记录（基于PHP后端的filterSensitiveData逻辑）
     * @param cdk 注册码
     * @param deviceId 设备ID（支持UUID和IMEI格式）
     * @return std::string 脱敏后的信息
     */
    std::string filterSensitiveData(const std::string& cdk, const std::string& deviceId) {
        std::string filteredInfo;
        
        if (!cdk.empty()) {
            if (cdk.length() >= 8) {
                filteredInfo += "CDK:" + cdk.substr(0, 4) + "****" + cdk.substr(cdk.length() - 4);
            } else {
                filteredInfo += "CDK:****";
            }
        }
        
        if (!deviceId.empty()) {
            if (!filteredInfo.empty()) filteredInfo += ", ";
            
            // 针对36位UUID格式特殊处理
            if (deviceId.length() == 36 && deviceId[8] == '-' && deviceId[13] == '-' && 
                deviceId[18] == '-' && deviceId[23] == '-') {
                // UUID格式：12345678-1234-4567-89ab-123456789012
                // 脱敏为：1234****-****-****-****-*********012
                filteredInfo += "DeviceID:" + deviceId.substr(0, 4) + "****-****-****-****-*********" + deviceId.substr(deviceId.length() - 3);
            } else if (deviceId.length() >= 8) {
                // 传统格式脱敏
                filteredInfo += "DeviceID:" + deviceId.substr(0, 4) + "***" + deviceId.substr(deviceId.length() - 4);
            } else {
                filteredInfo += "DeviceID:***";
            }
        }
        
        return filteredInfo;
    }
    
    /**
     * 验证canshu参数值
     * @param canshu 参数值
     * @return bool 是否有效
     */
    bool validateCanshu(const std::string& canshu) {
        // 支持字符串格式的操作类型，对应PHP后端的switch case
        std::vector<std::string> validValues = {"login", "heart", "checksignature"};
        for (const auto& valid : validValues) {
            if (canshu == valid) {
                LOGD("canshu验证通过: %s", canshu.c_str());
                return true;
            }
        }
        LOGW("canshu验证：无效值: %s (有效值: login, heart, offimei)", canshu.c_str());
        return false;
    }
}

// ==================== 解压缩数据存储功能 ====================

// 全局变量：存储解压缩的文件数据 (key: 文件路径, value: 文件数据)
static std::map<std::string, std::string> g_unzippedFileDataMap;
static std::mutex g_unzippedDataMutex;

// AES-CBC解密工具函数（增强版 - 严格数据完整性检查）
std::string aes_cbc_decrypt(const std::string& encrypted, const std::string& key, const std::string& iv) {
    // ==================== 输入参数严格验证 ====================
    if (encrypted.empty()) {
        LOGE("AES解密: 输入加密数据为空");
        return "";
    }
    
    if (key.empty()) {
        LOGE("AES解密: 密钥为空");
        return "";
    }
    
    if (iv.empty()) {
        LOGE("AES解密: IV为空");
        return "";
    }
    
    // 验证加密数据大小（AES-CBC要求16字节对齐）
    if (encrypted.size() % 16 != 0) {
        LOGE("AES解密: 加密数据大小不是16字节对齐 - 大小=%zu", encrypted.size());
        return "";
    }
    
    // 计算输入数据校验和
    uint32_t inputChecksum = calculateChecksum(encrypted);
    LOGI("AES解密开始: 输入数据大小=%zu, 校验和=0x%08X", encrypted.size(), inputChecksum);
    
    // ==================== 密钥和IV准备 ====================
    unsigned char aes_key[32] = {0};
    unsigned char aes_iv[16] = {0};
    
    // 确保密钥为32字节（AES-256需要）
    size_t keyLen = std::min(key.size(), (size_t)32);
    memcpy(aes_key, key.data(), keyLen);
    
    // 确保IV为16字节
    size_t ivLen = std::min(iv.size(), (size_t)16);
    memcpy(aes_iv, iv.data(), ivLen);
    
    LOGD("AES解密: 密钥长度=%zu, IV长度=%zu", keyLen, ivLen);
    
    // 输出密钥和IV的十六进制表示用于调试
    std::stringstream keyHex, ivHex;
    for (size_t i = 0; i < keyLen && i < 16; i++) {
        keyHex << std::hex << std::setfill('0') << std::setw(2) << (int)aes_key[i];
    }
    for (size_t i = 0; i < ivLen; i++) {
        ivHex << std::hex << std::setfill('0') << std::setw(2) << (int)aes_iv[i];
    }
    LOGD("AES解密: 密钥前16字节=%s", keyHex.str().c_str());
    LOGD("AES解密: IV完整16字节=%s", ivHex.str().c_str());
    
    // 输出加密数据的前16字节用于调试
    std::stringstream dataHex;
    size_t debugLen = std::min(encrypted.size(), (size_t)16);
    for (size_t i = 0; i < debugLen; i++) {
        dataHex << std::hex << std::setfill('0') << std::setw(2) << (int)(unsigned char)encrypted[i];
        if (i < debugLen - 1) dataHex << " ";
    }
    LOGD("AES解密: 加密数据前16字节=%s", dataHex.str().c_str());
    
    // ==================== OpenSSL解密上下文初始化 ====================
    EVP_CIPHER_CTX* ctx = EVP_CIPHER_CTX_new();
    if (!ctx) {
        LOGE("AES解密: 无法创建加密上下文");
        return "";
    }
    
    // 初始化解密器
    if (EVP_DecryptInit_ex(ctx, EVP_aes_256_cbc(), NULL, aes_key, aes_iv) != 1) {
        LOGE("AES解密: 初始化解密器失败");
        EVP_CIPHER_CTX_free(ctx);
        return "";
    }
    
    LOGI("✅ AES解密上下文初始化成功");
    
    // ==================== 解密数据处理 ====================
    // 准备输出缓冲区（比输入稍大以容纳填充）
    std::vector<unsigned char> decrypted(encrypted.size() + 32);
    int outlen1 = 0, outlen2 = 0;
    
    // 解密数据更新阶段
    LOGD("开始解密数据更新阶段...");
    if (EVP_DecryptUpdate(ctx, decrypted.data(), &outlen1, 
                          (const unsigned char*)encrypted.data(), encrypted.size()) != 1) {
        LOGE("❌ AES解密: 解密更新失败");
        EVP_CIPHER_CTX_free(ctx);
        return "";
    }
    
    LOGD("✅ 解密更新完成，输出长度=%d", outlen1);
    
    // 解密数据完成阶段
    LOGD("开始解密数据完成阶段...");
    if (EVP_DecryptFinal_ex(ctx, decrypted.data() + outlen1, &outlen2) != 1) {
        // 获取更详细的错误信息
        unsigned long err = ERR_get_error();
        char err_buf[256];
        ERR_error_string_n(err, err_buf, sizeof(err_buf));
        LOGE("❌ AES解密: 解密完成失败 - %s", err_buf);
        LOGE("可能原因：1.填充错误 2.密钥不正确 3.数据损坏 4.数据不是AES加密的");
        
        // 输出更多调试信息
        LOGE("调试信息: 输入大小=%zu, 第一阶段输出=%d", encrypted.size(), outlen1);
        
        EVP_CIPHER_CTX_free(ctx);
        return "";
    }
    
    EVP_CIPHER_CTX_free(ctx);
    
    // ==================== 解密结果验证 ====================
    int totalLen = outlen1 + outlen2;
    if (totalLen <= 0) {
        LOGE("❌ AES解密: 解密后数据长度无效 - totalLen=%d", totalLen);
        return "";
    }
    
    LOGI("✅ AES解密完成: 原始大小=%zu, 解密后大小=%d", encrypted.size(), totalLen);
    
    // 创建结果字符串
    std::string result((char*)decrypted.data(), totalLen);
    
    // 验证结果数据完整性
    uint32_t resultChecksum = calculateChecksum(result);
    LOGI("解密结果验证: 大小=%d, 校验和=0x%08X", totalLen, resultChecksum);
    
    // 输出解密后数据的前16字节用于验证
    std::stringstream decryptedHex;
    size_t decDebugLen = std::min((size_t)totalLen, (size_t)16);
    for (size_t i = 0; i < decDebugLen; i++) {
        decryptedHex << std::hex << std::setfill('0') << std::setw(2) << (int)(unsigned char)result[i];
        if (i < decDebugLen - 1) decryptedHex << " ";
    }
    LOGD("AES解密: 解密数据前16字节=%s", decryptedHex.str().c_str());
    
    // 检查解密后数据是否包含可疑的全零或全FF模式（可能表示解密失败）
    bool allZero = true, allFF = true;
    size_t checkLen = std::min((size_t)totalLen, (size_t)32);
    for (size_t i = 0; i < checkLen; i++) {
        unsigned char c = (unsigned char)result[i];
        if (c != 0x00) allZero = false;
        if (c != 0xFF) allFF = false;
        if (!allZero && !allFF) break;
    }
    
    if (allZero && totalLen > 16) {
        LOGW("⚠️ AES解密警告: 解密结果前%zu字节全为零，可能解密失败", checkLen);
    } else if (allFF && totalLen > 16) {
        LOGW("⚠️ AES解密警告: 解密结果前%zu字节全为0xFF，可能解密失败", checkLen);
    } else {
        LOGI("✅ AES解密数据模式检查通过");
    }
    
    LOGI("🎉 AES解密成功完成: 输入=%zu字节 -> 输出=%d字节", encrypted.size(), totalLen);
    return result;
}

// 辅助函数：检查字符串是否为十六进制格式
bool isHexString(const std::string& str) {
    if (str.empty() || str.length() % 2 != 0) {
        return false;
    }
    
    for (char c : str) {
        if (!std::isxdigit(c)) {
            return false;
        }
    }
    return true;
}

// 辅助函数：将十六进制字符串转换为二进制数据
std::string hexStringToBinary(const std::string& hexStr) {
    if (hexStr.length() % 2 != 0) {
        LOGE("hexStringToBinary: 十六进制字符串长度不是偶数");
        return "";
    }
    
    std::string binary;
    binary.reserve(hexStr.length() / 2);
    
    for (size_t i = 0; i < hexStr.length(); i += 2) {
        std::string byteString = hexStr.substr(i, 2);
        try {
            unsigned char byte = static_cast<unsigned char>(std::stoul(byteString, nullptr, 16));
            binary.push_back(static_cast<char>(byte));
        } catch (const std::exception& e) {
            LOGE("hexStringToBinary: 转换失败 - %s", e.what());
            return "";
        }
    }
    
    return binary;
}

// 计算数据的简单校验和（用于数据完整性验证）
uint32_t calculateChecksum(const std::string& data) {
    uint32_t checksum = 0;
    for (size_t i = 0; i < data.size(); i++) {
        checksum = checksum * 31 + static_cast<unsigned char>(data[i]);
    }
    return checksum;
}

// 验证数据完整性的辅助函数
bool verifyDataIntegrity(const std::string& originalData, const std::string& processedData, const std::string& stage) {
    if (originalData.empty()) {
        LOGE("数据完整性验证[%s]: 原始数据为空", stage.c_str());
        return false;
    }
    
    if (processedData.empty()) {
        LOGE("数据完整性验证[%s]: 处理后数据为空", stage.c_str());
        return false;
    }
    
    // 计算校验和
    uint32_t originalChecksum = calculateChecksum(originalData);
    uint32_t processedChecksum = calculateChecksum(processedData);
    
    LOGD("数据完整性验证[%s]: 原始数据大小=%zu, 校验和=0x%08X", 
         stage.c_str(), originalData.size(), originalChecksum);
    LOGD("数据完整性验证[%s]: 处理后数据大小=%zu, 校验和=0x%08X", 
         stage.c_str(), processedData.size(), processedChecksum);
    
    return true; // 数据完整性验证通过
}

// 保存解压缩的文件数据到全局存储（增强版 - 严格数据完整性检查）
void saveUnzippedFileData(const std::string& fileName, const jbyte* data, jsize dataSize) {
    if (fileName.empty() || data == nullptr || dataSize <= 0) {
        LOGE("saveUnzippedFileData: 输入参数无效 - fileName=%s, data=%p, dataSize=%d", 
             fileName.empty() ? "空" : fileName.c_str(), data, dataSize);
        return;
    }
    
    // 获取当前线程ID用于调试
    std::thread::id current_thread_id = std::this_thread::get_id();
    std::stringstream thread_ss;
    thread_ss << current_thread_id;
    
    // 提取相对路径，去掉"mod_fgcq/stab/"前缀
    std::string relativePath = fileName;
    const std::string prefix = "mod_fgcq/stab/";
    if (relativePath.length() > prefix.length() && 
        relativePath.substr(0, prefix.length()) == prefix) {
        relativePath = relativePath.substr(prefix.length());
    }
    
    LOGI("数据处理开始: [线程:%s] 文件=%s, 原始大小=%d字节", 
         thread_ss.str().c_str(), relativePath.c_str(), dataSize);
    
    // ==================== 阶段1: 原始数据接收和验证 ====================
    std::string originalData(reinterpret_cast<const char*>(data), dataSize);
    
    // 验证原始数据完整性
    if (originalData.size() != static_cast<size_t>(dataSize)) {
        LOGE("❌ 阶段1失败: 原始数据大小不匹配 - 期望=%d, 实际=%zu", dataSize, originalData.size());
        return;
    }
    
    uint32_t originalChecksum = calculateChecksum(originalData);
    LOGI("✅ 阶段1成功: 原始数据接收完整 - 大小=%zu, 校验和=0x%08X", 
         originalData.size(), originalChecksum);
    
    // 输出原始数据的前32字节用于调试
    std::stringstream originalHex;
    size_t debugLen = std::min(originalData.size(), (size_t)32);
    for (size_t i = 0; i < debugLen; i++) {
        originalHex << std::hex << std::setfill('0') << std::setw(2) 
                   << (int)(unsigned char)originalData[i];
        if (i < debugLen - 1) originalHex << " ";
    }
    LOGD("原始数据前32字节: %s", originalHex.str().c_str());
    
    // ==================== 阶段2: 十六进制格式检查和转换 ====================
    bool isHex = isHexString(originalData);
    LOGD("数据格式检查: %s", isHex ? "十六进制字符串" : "二进制数据");
    
    std::string binaryData;
    if (isHex) {
        LOGI("开始十六进制转换...");
        binaryData = hexStringToBinary(originalData);
        
        if (binaryData.empty()) {
            LOGE("❌ 阶段2失败: 十六进制转换失败，回退到原始数据");
            binaryData = originalData;
        } else {
            // 验证转换后数据完整性
            if (!verifyDataIntegrity(originalData, binaryData, "十六进制转换")) {
                LOGE("❌ 阶段2警告: 十六进制转换数据完整性验证失败");
        }
            
            // 验证转换比例是否正确（十六进制应该是2:1比例）
            if (binaryData.size() * 2 != originalData.size()) {
                LOGE("❌ 阶段2警告: 十六进制转换比例异常 - 原始=%zu, 转换后=%zu", 
                     originalData.size(), binaryData.size());
    } else {
                LOGI("✅ 阶段2成功: 十六进制转换完整 - %zu字符 -> %zu字节", 
                     originalData.size(), binaryData.size());
            }
        }
    } else {
        binaryData = originalData;
        LOGI("✅ 阶段2跳过: 数据已是二进制格式，直接使用");
    }
    
    // 输出二进制数据的前16字节用于调试
    std::stringstream binaryHex;
    size_t binaryDebugLen = std::min(binaryData.size(), (size_t)16);
    for (size_t i = 0; i < binaryDebugLen; i++) {
        binaryHex << std::hex << std::setfill('0') << std::setw(2) 
                 << (int)(unsigned char)binaryData[i];
        if (i < binaryDebugLen - 1) binaryHex << " ";
    }
    LOGD("二进制数据前16字节: %s", binaryHex.str().c_str());
    
    // ==================== 阶段3: AES解密处理 ====================
    LOGI("开始AES解密处理...");
    const std::string aes_key = "_ZN7cocos2d13tgaLoadBufferEE_ptr";
    const std::string aes_iv = "_ZN7cocos2d8LuaStack13luaLoadBufferEP9lua_StatePKciS4__ptr";
    
    // 记录解密前的数据状态
    uint32_t preDecryptChecksum = calculateChecksum(binaryData);
    LOGD("解密前数据: 大小=%zu, 校验和=0x%08X", binaryData.size(), preDecryptChecksum);
    
    std::string decryptedData = aes_cbc_decrypt(binaryData, aes_key, aes_iv);
    
    std::string finalData;
    if (!decryptedData.empty()) {
        // 验证解密后数据完整性
        if (!verifyDataIntegrity(binaryData, decryptedData, "AES解密")) {
            LOGE("❌ 阶段3警告: AES解密数据完整性验证失败");
        }
        
        uint32_t decryptedChecksum = calculateChecksum(decryptedData);
        LOGI("✅ 阶段3成功: AES解密完整 - 解密前=%zu字节, 解密后=%zu字节, 校验和=0x%08X", 
             binaryData.size(), decryptedData.size(), decryptedChecksum);
        
        // 输出解密后数据的前16字节用于验证
        std::stringstream decryptedHex;
        size_t decryptedDebugLen = std::min(decryptedData.size(), (size_t)16);
        for (size_t i = 0; i < decryptedDebugLen; i++) {
            decryptedHex << std::hex << std::setfill('0') << std::setw(2) 
                        << (int)(unsigned char)decryptedData[i];
            if (i < decryptedDebugLen - 1) decryptedHex << " ";
        }
        LOGD("解密后数据前16字节: %s", decryptedHex.str().c_str());
        
        finalData = std::move(decryptedData);
    } else {
        LOGW("❌ 阶段3失败: AES解密失败，使用二进制数据作为最终数据");
        finalData = std::move(binaryData);
    }
    
    // ==================== 阶段4: 最终数据存储 ====================
    if (finalData.empty()) {
        LOGE("❌ 数据处理失败: 最终数据为空，无法存储");
        return;
    }
    
    uint32_t finalChecksum = calculateChecksum(finalData);
    size_t finalDataSize = finalData.size(); // 保存大小，避免move后丢失
    LOGI("准备存储最终数据: 大小=%zu字节, 校验和=0x%08X", finalDataSize, finalChecksum);
    
    // 线程安全地保存数据
    {
        std::lock_guard<std::mutex> lock(g_unzippedDataMutex);
        
        // 检查是否已存在该文件（避免重复存储）
        if (g_unzippedFileDataMap.find(relativePath) != g_unzippedFileDataMap.end()) {
            LOGW("文件已存在，将被覆盖: %s", relativePath.c_str());
        }
        
        g_unzippedFileDataMap[relativePath] = std::move(finalData);
        
        // 验证存储后的数据完整性
        const std::string& storedData = g_unzippedFileDataMap[relativePath];
        uint32_t storedChecksum = calculateChecksum(storedData);
        
        if (storedChecksum == finalChecksum && storedData.size() == finalDataSize) {
            LOGI("✅ 阶段4成功: 数据存储完整 - 路径=%s, 大小=%zu字节, 校验和=0x%08X", 
                 relativePath.c_str(), storedData.size(), storedChecksum);
        } else {
            LOGE("❌ 阶段4失败: 数据存储后完整性验证失败!");
            LOGE("存储前: 大小=%zu, 校验和=0x%08X", finalDataSize, finalChecksum);
            LOGE("存储后: 大小=%zu, 校验和=0x%08X", storedData.size(), storedChecksum);
        }
    }
    
    LOGI("🎉 数据处理完成: [线程:%s] 文件=%s 已成功处理并存储", 
         thread_ss.str().c_str(), relativePath.c_str());
}

// 获取解压缩的文件数据
std::string getUnzippedFileData(const std::string& filePath) {
    std::lock_guard<std::mutex> lock(g_unzippedDataMutex);
    
    auto it = g_unzippedFileDataMap.find(filePath);
    if (it != g_unzippedFileDataMap.end()) {
        // LOGD("getUnzippedFileData: 找到文件数据 - 路径: %s, 大小: %zu 字节", 
        //      filePath.c_str(), it->second.length());
        return it->second;
    }
    
    // LOGW("getUnzippedFileData: 未找到文件数据 - 路径: %s", filePath.c_str());
    return "";
}


// 检查是否存在指定文件的数据
bool hasUnzippedFileData(const std::string& filePath) {
    std::lock_guard<std::mutex> lock(g_unzippedDataMutex);
    return (g_unzippedFileDataMap.find(filePath) != g_unzippedFileDataMap.end());
}

// 获取所有已解压缩文件的列表
std::vector<std::string> getUnzippedFileList() {
    std::lock_guard<std::mutex> lock(g_unzippedDataMutex);
    
    std::vector<std::string> fileList;
    fileList.reserve(g_unzippedFileDataMap.size());
    
    for (const auto& pair : g_unzippedFileDataMap) {
        fileList.push_back(pair.first);
    }
    
    LOGD("getUnzippedFileList: 返回 %zu 个文件的列表", fileList.size());
    
    return fileList;
}

// 遍历并输出所有解压缩数据的key-value信息
void logAllUnzippedFileData() {
    std::lock_guard<std::mutex> lock(g_unzippedDataMutex);
    
    if (g_unzippedFileDataMap.empty()) {
        LOGI("遍历解压数据: 没有解压缩的文件数据");
        return;
    }
    
    LOGI("遍历解压数据: 开始遍历所有解压缩的文件数据 (总计: %zu 个文件)", 
         g_unzippedFileDataMap.size());
    
    int index = 1;
    for (const auto& pair : g_unzippedFileDataMap) {
        const std::string& filePath = pair.first;
        const std::string& fileData = pair.second;
        
        // 输出文件信息
        LOGI("遍历解压数据: [%d] Key(文件路径): %s", index, filePath.c_str());
        LOGI("遍历解压数据: [%d] Value(数据大小): %zu 字节", index, fileData.size());
        
        // 如果是文本文件，输出前100个字符的预览
        if (fileData.size() > 0) {
            // 检查是否为文本文件（简单判断：检查前几个字节是否为可打印字符）
            bool isTextFile = true;
            size_t checkLength = std::min(fileData.size(), static_cast<size_t>(50));
            
            for (size_t i = 0; i < checkLength; i++) {
                unsigned char c = static_cast<unsigned char>(fileData[i]);
                if (c < 32 && c != '\n' && c != '\r' && c != '\t') {
                    isTextFile = false;
                    break;
                }
            }
            
            if (isTextFile) {
                // 文本文件，输出前100个字符的预览
                size_t previewLength = std::min(fileData.size(), static_cast<size_t>(100));
                std::string preview = fileData.substr(0, previewLength);
                
                // 替换换行符为空格，便于日志显示
                std::replace(preview.begin(), preview.end(), '\n', ' ');
                std::replace(preview.begin(), preview.end(), '\r', ' ');
                std::replace(preview.begin(), preview.end(), '\t', ' ');
                
                LOGI("遍历解压数据: [%d] 内容预览(文本): %s%s", 
                     index, preview.c_str(), 
                     fileData.size() > 100 ? "..." : "");
            } else {
                // 二进制文件，输出十六进制预览
                size_t previewLength = std::min(fileData.size(), static_cast<size_t>(32));
                std::stringstream hexStream;
                
                for (size_t i = 0; i < previewLength; i++) {
                    unsigned char c = static_cast<unsigned char>(fileData[i]);
                    hexStream << std::hex << std::setfill('0') << std::setw(2) << static_cast<int>(c);
                    if (i < previewLength - 1) hexStream << " ";
                }
                
                LOGI("遍历解压数据: [%d] 内容预览(二进制): %s%s", 
                     index, hexStream.str().c_str(),
                     fileData.size() > 32 ? "..." : "");
            }
        } else {
            LOGI("遍历解压数据: [%d] 内容: 空文件", index);
        }
        
        LOGI("遍历解压数据: [%d] ----------------------------------------", index);
        index++;
    }
    
    LOGI("遍历解压数据: 遍历完成，共处理 %d 个文件", index - 1);
}

// 在解压缩数据中搜索包含指定字符串的文件
std::vector<std::string> searchStringInUnzippedFiles(const std::string& searchString, bool caseSensitive) {
    std::vector<std::string> matchedFiles;
    
    if (searchString.empty()) {
        LOGW("searchStringInUnzippedFiles: 搜索字符串为空");
        return matchedFiles;
    }
    
    std::lock_guard<std::mutex> lock(g_unzippedDataMutex);
    
    if (g_unzippedFileDataMap.empty()) {
        LOGI("searchStringInUnzippedFiles: 没有解压缩的文件数据可搜索");
        return matchedFiles;
    }
    
    LOGI("🔍 开始搜索字符串: \"%s\" (大小写%s)", searchString.c_str(), 
         caseSensitive ? "敏感" : "不敏感");
    LOGI("搜索范围: %zu 个解压缩文件", g_unzippedFileDataMap.size());
    
    // 准备搜索字符串（如果不区分大小写，转换为小写）
    std::string searchTarget = searchString;
    if (!caseSensitive) {
        std::transform(searchTarget.begin(), searchTarget.end(), searchTarget.begin(), ::tolower);
    }
    
    int searchCount = 0;
    int matchCount = 0;
    
    for (const auto& pair : g_unzippedFileDataMap) {
        const std::string& filePath = pair.first;
        const std::string& fileData = pair.second;
        searchCount++;
        
        // 验证文件数据完整性
        if (fileData.empty()) {
            LOGW("搜索跳过: 文件数据为空 - %s", filePath.c_str());
            continue;
        }
        
        // 计算文件数据校验和用于完整性验证
        uint32_t dataChecksum = calculateChecksum(fileData);
        
        // 准备搜索内容（如果不区分大小写，转换为小写）
        std::string searchContent = fileData;
        if (!caseSensitive) {
            std::transform(searchContent.begin(), searchContent.end(), searchContent.begin(), ::tolower);
        }
        
        // 执行字符串搜索
        size_t pos = searchContent.find(searchTarget);
        if (pos != std::string::npos) {
            matchCount++;
            matchedFiles.push_back(filePath);
            
            LOGI("✅ 找到匹配[%d]: 文件=%s, 位置=%zu, 数据大小=%zu, 校验和=0x%08X", 
                 matchCount, filePath.c_str(), pos, fileData.size(), dataChecksum);
            
            // 输出匹配上下文（前后各50个字符）
            size_t contextStart = (pos >= 50) ? pos - 50 : 0;
            size_t contextEnd = std::min(pos + searchString.length() + 50, fileData.size());
            std::string context = fileData.substr(contextStart, contextEnd - contextStart);
            
            // 替换换行符和特殊字符以便日志显示
            std::replace(context.begin(), context.end(), '\n', '\\');
            std::replace(context.begin(), context.end(), '\r', '\\');
            std::replace(context.begin(), context.end(), '\t', ' ');
            
            LOGI("匹配上下文: ...%s...", context.c_str());
            
            // 验证匹配位置的数据完整性
            if (pos + searchString.length() <= fileData.size()) {
                std::string actualMatch = fileData.substr(pos, searchString.length());
                if (caseSensitive) {
                    if (actualMatch == searchString) {
                        LOGD("✅ 匹配验证通过: 精确匹配");
                    } else {
                        LOGW("⚠️ 匹配验证异常: 期望=\"%s\", 实际=\"%s\"", 
                             searchString.c_str(), actualMatch.c_str());
                    }
                } else {
                    std::string lowerMatch = actualMatch;
                    std::transform(lowerMatch.begin(), lowerMatch.end(), lowerMatch.begin(), ::tolower);
                    if (lowerMatch == searchTarget) {
                        LOGD("✅ 匹配验证通过: 不区分大小写匹配");
                    } else {
                        LOGW("⚠️ 匹配验证异常: 期望=\"%s\", 实际=\"%s\"", 
                             searchTarget.c_str(), lowerMatch.c_str());
                    }
                }
            } else {
                LOGE("❌ 匹配位置超出数据范围: pos=%zu, length=%zu, dataSize=%zu", 
                     pos, searchString.length(), fileData.size());
            }
        }
        
        // 每搜索100个文件输出一次进度
        if (searchCount % 100 == 0) {
            LOGD("搜索进度: %d/%zu 文件已处理", searchCount, g_unzippedFileDataMap.size());
        }
    }
    
    LOGI("🎉 搜索完成: 搜索了%d个文件, 找到%d个匹配", searchCount, matchCount);
    
    return matchedFiles;
}

// 在解压缩数据中搜索多个字符串（AND逻辑 - 文件必须包含所有字符串）
std::vector<std::string> searchMultipleStringsInUnzippedFiles(const std::vector<std::string>& searchStrings, bool caseSensitive) {
    std::vector<std::string> matchedFiles;
    
    if (searchStrings.empty()) {
        LOGW("searchMultipleStringsInUnzippedFiles: 搜索字符串列表为空");
        return matchedFiles;
    }
    
    std::lock_guard<std::mutex> lock(g_unzippedDataMutex);
    
    if (g_unzippedFileDataMap.empty()) {
        LOGI("searchMultipleStringsInUnzippedFiles: 没有解压缩的文件数据可搜索");
        return matchedFiles;
    }
    
    LOGI("🔍 开始多字符串搜索 (AND逻辑): %zu个搜索条件", searchStrings.size());
    for (size_t i = 0; i < searchStrings.size(); i++) {
        LOGI("搜索条件[%zu]: \"%s\"", i + 1, searchStrings[i].c_str());
    }
    
    int searchCount = 0;
    int matchCount = 0;
    
    for (const auto& pair : g_unzippedFileDataMap) {
        const std::string& filePath = pair.first;
        const std::string& fileData = pair.second;
        searchCount++;
        
        // 验证文件数据完整性
        if (fileData.empty()) {
            continue;
        }
        
        // 准备搜索内容
        std::string searchContent = fileData;
        if (!caseSensitive) {
            std::transform(searchContent.begin(), searchContent.end(), searchContent.begin(), ::tolower);
        }
        
        // 检查是否包含所有搜索字符串
        bool allFound = true;
        std::vector<size_t> positions;
        
        for (const std::string& searchStr : searchStrings) {
            std::string target = searchStr;
            if (!caseSensitive) {
                std::transform(target.begin(), target.end(), target.begin(), ::tolower);
            }
            
            size_t pos = searchContent.find(target);
            if (pos != std::string::npos) {
                positions.push_back(pos);
            } else {
                allFound = false;
                break;
            }
        }
        
        if (allFound) {
            matchCount++;
            matchedFiles.push_back(filePath);
            
            uint32_t dataChecksum = calculateChecksum(fileData);
            LOGI("✅ 多条件匹配[%d]: 文件=%s, 数据大小=%zu, 校验和=0x%08X", 
                 matchCount, filePath.c_str(), fileData.size(), dataChecksum);
            
            // 输出所有匹配位置
            for (size_t i = 0; i < positions.size(); i++) {
                LOGI("条件[%zu]位置: %zu", i + 1, positions[i]);
            }
        }
    }
    
    LOGI("🎉 多字符串搜索完成: 搜索了%d个文件, 找到%d个完全匹配", searchCount, matchCount);
    
    return matchedFiles;
}

// 获取文件数据的详细信息（包括完整性验证）
std::string getFileDataInfo(const std::string& filePath) {
    std::lock_guard<std::mutex> lock(g_unzippedDataMutex);
    
    auto it = g_unzippedFileDataMap.find(filePath);
    if (it == g_unzippedFileDataMap.end()) {
        return "文件不存在: " + filePath;
    }
    
    const std::string& fileData = it->second;
    uint32_t checksum = calculateChecksum(fileData);
    
    std::stringstream info;
    info << "文件路径: " << filePath << "\n";
    info << "数据大小: " << fileData.size() << " 字节\n";
    info << "数据校验和: 0x" << std::hex << std::uppercase << checksum << "\n";
    
    // 分析数据类型
    if (fileData.empty()) {
        info << "数据类型: 空文件\n";
    } else {
        // 检查是否为文本文件
        bool isText = true;
        size_t checkLen = std::min(fileData.size(), (size_t)100);
        for (size_t i = 0; i < checkLen; i++) {
            unsigned char c = (unsigned char)fileData[i];
            if (c < 32 && c != '\n' && c != '\r' && c != '\t') {
                isText = false;
                break;
            }
        }
        
        info << "数据类型: " << (isText ? "文本文件" : "二进制文件") << "\n";
        
        // 输出前100字节的预览
        size_t previewLen = std::min(fileData.size(), (size_t)100);
        if (isText) {
            std::string preview = fileData.substr(0, previewLen);
            std::replace(preview.begin(), preview.end(), '\n', '\\');
            std::replace(preview.begin(), preview.end(), '\r', '\\');
            info << "内容预览: " << preview;
            if (fileData.size() > 100) info << "...";
            info << "\n";
        } else {
            info << "十六进制预览: ";
            for (size_t i = 0; i < previewLen; i++) {
                info << std::hex << std::setfill('0') << std::setw(2) 
                     << (int)(unsigned char)fileData[i];
                if (i < previewLen - 1) info << " ";
            }
            if (fileData.size() > 100) info << "...";
            info << "\n";
        }
    }
    
    return info.str();
}

