// ==================== 实时更新验证参数 ====================

// 更新验证参数
void updateVerificationParameters() {
    LOGI("正在更新验证参数...");
    
    // 清理缓存，强制重新验证
    {
        std::lock_guard<std::mutex> lock(g_verificationMutex);
        g_verificationCache.clear();
    }
    
    LOGI("验证参数已更新");
}

// 获取验证状态
std::string getVerificationStatus() {
    std::lock_guard<std::mutex> lock(g_verificationMutex);
    
    std::stringstream status;
    status << "域名验证状态:\n";
    status << "当前域名: " << (g_extractedDomain.empty() ? "未设置" : g_extractedDomain) << "\n";
    status << "域名白名单验证: " << (g_extractedDomain == "gmcdk.top" ? "✅ 通过" : "❌ 失败") << "\n";
    status << "验证缓存大小: " << g_verificationCache.size() << "\n";
    status << "验证初始化: " << (g_verificationInitialized.load() ? "是" : "否") << "\n";
    
    // 显示缓存中的验证结果
    if (!g_verificationCache.empty()) {
        status << "\n验证缓存详情:\n";
        for (const auto& pair : g_verificationCache) {
            status << "域名: " << pair.first << " -> 状态: " << pair.second << "\n";
        }
    }
    
    return status.str();
}

