// 时间戳和签名系统 - 使用本地时间戳
std::string getServerTimestampWithFailover() {
    LOGI("使用本地时间戳");
    
    // 直接使用本地时间戳
    auto now = std::chrono::system_clock::now();
    auto timestamp = std::chrono::duration_cast<std::chrono::seconds>(now.time_since_epoch()).count();
    std::string result = std::to_string(timestamp);
    
    LOGI("本地时间戳: %s", result.c_str());
    return result;
}

// 获取并验证本地时间戳
std::string getValidatedLocalTimestamp() {
    LOGI("开始获取本地时间戳...");
    
    // 获取当前时间戳
    auto now = std::chrono::system_clock::now();
    auto timestamp = std::chrono::duration_cast<std::chrono::seconds>(now.time_since_epoch()).count();
    std::string result = std::to_string(timestamp);
    
    LOGI("本地时间戳: %s", result.c_str());
    return result;
}

// 测试时间戳获取功能
void testTimestampAcquisition() {
    LOGI("开始测试时间戳获取功能...");
    
    std::string timestamp = getServerTimestampWithFailover();
    
    if (!timestamp.empty()) {
        LOGI("时间戳获取成功: %s", timestamp.c_str());
        
        // 验证时间戳格式
        try {
            long long ts = std::stoll(timestamp);
            auto now = std::chrono::system_clock::now();
            auto currentTime = std::chrono::duration_cast<std::chrono::seconds>(now.time_since_epoch()).count();
            
            long long diff = std::abs(ts - currentTime);
            if (diff <= 300) { // 5分钟内的差异认为是正常的
                LOGI("时间戳验证通过，与本地时间差异: %lld秒", diff);
            } else {
                LOGW("时间戳与本地时间差异较大: %lld秒", diff);
            }
        } catch (const std::exception& e) {
            LOGE("时间戳格式验证失败: %s", e.what());
        }
    } else {
        LOGE("时间戳获取失败");
    }
}

std::string md5Hash(const std::string& input) {
#ifndef NO_OPENSSL
    unsigned char hash[MD5_DIGEST_LENGTH];
    MD5((unsigned char*)input.c_str(), input.length(), hash);
    
    std::string result;
    for (int i = 0; i < MD5_DIGEST_LENGTH; i++) {
        char hex[3];
        sprintf(hex, "%02x", hash[i]);
        result += hex;
    }
    return result;
#else
    // 简单的MD5实现（如果没有OpenSSL）
    return "md5_" + std::to_string(std::hash<std::string>{}(input));
#endif
}

std::string generateRequestSignature(const std::string& apiPassword, const std::string& timestamp) {
    std::string input = apiPassword + timestamp;  // API密码在前，时间戳在后
    return md5Hash(input);
}

bool verifyResponseSignature(const std::string& timestamp, const std::string& apiPassword, const std::string& receivedSign) {
    std::string input = timestamp + apiPassword;  // 时间戳在前，API密码在后
    std::string expectedSign = md5Hash(input);
    return expectedSign == receivedSign;
}

// 多服务器管理
std::vector<std::string> getAvailableServers() {
    return {
        CARD_API_SERVER_1,
        CARD_API_SERVER_2,
        CARD_API_SERVER_3
    };
}

std::string selectRandomServer() {
    std::vector<std::string> servers = getAvailableServers();
    return servers[rand() % servers.size()];
}

bool isValidJsonResponse(const std::string& response) {
    if (response.empty()) return false;
    
    // 检查是否包含JSON结构
    if (response.find("{") == std::string::npos || 
        response.find("}") == std::string::npos) return false;
    
    // 检查是否包含必要的字段
    if (response.find("\"code\"") == std::string::npos) return false;
    
    return true;
}

// 改进的HTTP GET请求函数，带重试机制
std::string performHttpGetWithRetry(const std::string& url, int maxRetries) {
    for (int attempt = 0; attempt < maxRetries; attempt++) {
        LOGI("HTTP GET 尝试 %d/%d: %s", attempt + 1, maxRetries, url.c_str());
        
        std::string response = performHttpGet(url);
        
        if (!response.empty()) {
            LOGI("HTTP GET 成功，响应长度: %zu", response.length());
            return response;
        }
        
        if (attempt < maxRetries - 1) {
            LOGW("HTTP GET 失败，%d秒后重试...", (attempt + 1) * 2);
            std::this_thread::sleep_for(std::chrono::seconds((attempt + 1) * 2));
        }
    }
    
    LOGE("HTTP GET 最终失败: %s", url.c_str());
    return "";
}

std::string performRequestWithFailover(const std::string& endpoint, const std::map<std::string, std::string>& params, int maxRetries) {
    std::vector<std::string> servers = getAvailableServers();
    
    for (int attempt = 0; attempt < maxRetries; attempt++) {
        std::string server = servers[rand() % servers.size()];
        std::string url = server + endpoint;
        
        LOGI("尝试请求: %s (第%d次)", url.c_str(), attempt + 1);
        
#ifndef NO_CURL
        // 构建POST数据
        std::string postData = "";
        for (const auto& param : params) {
            if (!postData.empty()) postData += "&";
            postData += param.first + "=" + param.second;
        }
        
        long responseCode = 0;
        std::string response = performHttpPost(url, postData, &responseCode, HTTP_ENCRYPT);
        
        // 验证JSON响应
        if (isValidJsonResponse(response)) {
            LOGI("请求成功: %s", response.c_str());
            return response;
        }
#endif
        
        LOGW("服务器 %s 响应无效，尝试下一个服务器", server.c_str());
    }
    
    return "Error: 所有服务器均不可用";
}

// 卡密验证新接口
std::string cardLogin(const std::string& card) {
    LOGI("==================== 卡密登录开始 ====================");
    LOGI("输入卡密: %s", card.c_str());
    LOGI("软件名称: %s", CARD_API_SOFTWARE);
    LOGI("开发者ID: %s", CARD_API_CENTER_ID);
    
    // 获取服务器时间戳
    LOGI("步骤1: 获取服务器时间戳...");
    std::string timestamp = getServerTimestampWithFailover();
    if (timestamp.empty()) {
        LOGE("❌ 无法获取服务器时间戳");
        return "Error: 无法获取服务器时间戳";
    }
    LOGI("✅ 服务器时间戳获取成功: %s", timestamp.c_str());
    
    // 获取设备ID（防止异地登录）
    LOGI("步骤2: 获取设备ID...");
    std::string deviceId = getDeviceId();
    LOGI("✅ 设备ID获取成功: %s", deviceId.substr(0, 8).c_str());
    
    // 按照Lua实现进行设备ID加密处理
    LOGI("步骤3: 设备ID加密处理...");
    std::string clientKey = md5Hash(CARD_API_PASSWORD + deviceId + timestamp);
    LOGI("✅ 设备ID加密完成: %s", clientKey.substr(0, 8).c_str());
    
    // 生成请求签名（按照Lua实现：使用加密后的client_key）
    LOGI("步骤4: 生成请求签名...");
    std::string apiPasswordWithKey = CARD_API_PASSWORD + clientKey;
    std::string sign = md5Hash(apiPasswordWithKey + timestamp);
    LOGI("✅ 请求签名生成成功: %s", sign.c_str());
    
    // 构建请求参数
    LOGI("步骤5: 构建请求参数...");
    std::map<std::string, std::string> params = {
        {HTTP_PARAM_CARD, card},
        {HTTP_PARAM_SOFTWARE, CARD_API_SOFTWARE},
        {HTTP_PARAM_CENTER_ID, CARD_API_CENTER_ID},
        {HTTP_PARAM_TIMESTAMP, timestamp},
        {HTTP_PARAM_SIGN, sign},
        {HTTP_PARAM_CLIENT_KEY, clientKey}  // 添加client_key参数
    };
    
    // 打印所有请求参数
    LOGI("请求参数详情:");
    for (const auto& param : params) {
        LOGI("  %s = %s", param.first.c_str(), param.second.c_str());
    }
    
    // 执行请求
    LOGI("步骤4: 发送HTTP请求到服务器...");
    LOGI("请求端点: %s", HTTP_API_CARD_LOGIN);
    std::string response = performRequestWithFailover(HTTP_API_CARD_LOGIN, params);
    
    if (response.find("Error:") == 0) {
        LOGE("❌ HTTP请求失败: %s", response.c_str());
        return response;
    }
    LOGI("✅ HTTP请求成功，响应长度: %zu", response.length());
    LOGI("服务器响应: %s", response.c_str());
    
    // 解析响应
    LOGI("步骤5: 解析服务器响应...");
    CardLoginResponse loginResponse = parseCardLoginResponse(response);
    
    if (loginResponse.success) {
        LOGI("==================== 卡密登录成功 ====================");
        LOGI("✅ 卡密类型: %s", loginResponse.type.c_str());
        LOGI("✅ 到期时间: %s", loginResponse.endtime.c_str());
        LOGI("✅ 剩余时间: %s", loginResponse.less_time.c_str());
        LOGI("✅ 时间戳: %ld", loginResponse.endtime_timestamp);
        LOGI("✅ 登录标识: %s", loginResponse.needle.c_str());
        LOGI("✅ 响应签名: %s", loginResponse.sign.c_str());
        
        // 保存登录时的关键参数用于后续心跳验证
        globalNeedle = loginResponse.needle;
        globalClientKey = clientKey;
        globalSign = sign;
        globalTimestamp = timestamp;
        globalDeviceIdForLogin = deviceId;
        LOGI("✅ 已保存登录标识到全局变量");
        LOGI("✅ 已保存登录参数: client_key=%s, sign=%s, timestamp=%s", 
             globalClientKey.substr(0, 8).c_str(), 
             globalSign.substr(0, 8).c_str(), 
             globalTimestamp.c_str());
        
        std::string result = "SUCCESS:" + loginResponse.endtime + ":" + loginResponse.needle;
        LOGI("返回结果: %s", result.c_str());
        return result;
    } else {
        LOGE("==================== 卡密登录失败 ====================");
        LOGE("❌ 服务器返回失败状态");
        LOGE("❌ 原始响应: %s", response.c_str());
        return "Error: 卡密登录失败";
    }
}

std::string cardHeartbeat(const std::string& card, const std::string& needle) {
    LOGI("==================== 卡密心跳验证开始 ====================");
    LOGI("登录标识: %s", needle.c_str());

    if (card.empty()) {
        LOGE("cardHeartbeat: 卡密为空，无法发送心跳");
        return "Error: 心跳参数错误";
    }

    if (needle.empty()) {
        LOGE("cardHeartbeat: needle为空，无法发送心跳");
        return "Error: 心跳参数错误";
    }

    std::string maskedCard = card.length() > 4 ? std::string("***") + card.substr(card.length() - 4) : card;
    LOGI("心跳使用卡密标识: %s", maskedCard.c_str());

    // 构建请求参数（参考Python实现）
    LOGI("步骤1: 构建请求参数...");
    
    // 获取当前时间戳（动态生成，不使用登录时保存的值）
    std::string timestamp = getServerTimestampWithFailover();
    
    // 生成签名（动态生成，不使用登录时保存的值）
    std::string sign = md5Hash(CARD_API_PASSWORD + timestamp);
    
    // 根据Python实现，心跳请求只包含card和needle
    // 其他参数在performRequestWithFailover中动态添加
    std::map<std::string, std::string> params = {
        {HTTP_PARAM_CARD, card},
        {HTTP_PARAM_NEEDLE, needle}
    };
    
    // 添加全局参数（参考Python实现）
    params[HTTP_PARAM_CENTER_ID] = CARD_API_CENTER_ID;
    params[HTTP_PARAM_SOFTWARE] = CARD_API_SOFTWARE;
    params[HTTP_PARAM_TIMESTAMP] = timestamp;
    params[HTTP_PARAM_SIGN] = sign;

    LOGI("请求参数详情:");
    for (const auto& param : params) {
        LOGI("  %s = %s", param.first.c_str(), param.second.c_str());
    }

    // 执行请求
    LOGI("步骤2: 发送HTTP请求到服务器...");
    LOGI("请求端点: %s", CARD_API_CARD_PING_ENDPOINT);
    std::string response = performRequestWithFailover(CARD_API_CARD_PING_ENDPOINT, params);

    if (response.find("Error:") == 0) {
        LOGE("❌ HTTP请求失败: %s", response.c_str());
        return response;
    }

    LOGI("✅ HTTP请求成功，响应长度: %zu", response.length());
    LOGD("心跳接口原始响应: %s", response.c_str());

    try {
        nlohmann::json jsonResponse = nlohmann::json::parse(response);

        std::string code;
        if (jsonResponse.contains("code")) {
            if (jsonResponse["code"].is_string()) {
                code = jsonResponse["code"].get<std::string>();
            } else if (jsonResponse["code"].is_number_integer()) {
                code = std::to_string(jsonResponse["code"].get<long long>());
            }
        }

        if (code != "1") {
            std::string message = jsonResponse.contains("msg") && jsonResponse["msg"].is_string()
                                      ? jsonResponse["msg"].get<std::string>()
                                      : "心跳验证失败";
            LOGE("卡密心跳验证失败，code=%s，msg=%s", code.c_str(), message.c_str());
            return "Error: " + message;
        }

        std::string timestampStr;
        if (jsonResponse.contains("time")) {
            if (jsonResponse["time"].is_string()) {
                timestampStr = jsonResponse["time"].get<std::string>();
            } else if (jsonResponse["time"].is_number_integer()) {
                timestampStr = std::to_string(jsonResponse["time"].get<long long>());
            }
        }

        std::string responseSign;
        if (jsonResponse.contains("sign") && jsonResponse["sign"].is_string()) {
            responseSign = jsonResponse["sign"].get<std::string>();
        }

        if (!timestampStr.empty() && !responseSign.empty()) {
            if (!verifyResponseSignature(timestampStr, CARD_API_PASSWORD, responseSign)) {
                LOGW("心跳响应签名校验失败，timestamp=%s, sign=%s", timestampStr.c_str(), responseSign.c_str());
            }
        }

        if (!jsonResponse.contains("data") || !jsonResponse["data"].is_object()) {
            LOGW("心跳响应缺少 data 字段，原始响应: %s", response.c_str());
            return "SUCCESS: 心跳验证成功";
        }

        const auto& dataNode = jsonResponse["data"];

        std::string endtime;
        if (dataNode.contains("endtime") && dataNode["endtime"].is_string()) {
            endtime = dataNode["endtime"].get<std::string>();
        }

        long endtimeTimestamp = 0;
        if (dataNode.contains("endtime_timestamp")) {
            if (dataNode["endtime_timestamp"].is_number_integer()) {
                endtimeTimestamp = dataNode["endtime_timestamp"].get<long long>();
            } else if (dataNode["endtime_timestamp"].is_string()) {
                try {
                    endtimeTimestamp = std::stol(dataNode["endtime_timestamp"].get<std::string>());
                } catch (...) {
                    LOGW("心跳响应 endtime_timestamp 解析失败");
                }
            }
        }

        std::string lessTime;
        if (dataNode.contains("less_time") && dataNode["less_time"].is_string()) {
            lessTime = dataNode["less_time"].get<std::string>();
        }

        int heartbeatInterval = 0;
        if (dataNode.contains("heartbeat_second")) {
            if (dataNode["heartbeat_second"].is_number_integer()) {
                heartbeatInterval = dataNode["heartbeat_second"].get<int>();
            } else if (dataNode["heartbeat_second"].is_string()) {
                try {
                    heartbeatInterval = std::stoi(dataNode["heartbeat_second"].get<std::string>());
                } catch (...) {
                    LOGW("心跳响应 heartbeat_second 解析失败");
                }
            }
        }

        LOGI("心跳解析成功 - 到期时间: %s, 剩余时间: %s, 心跳间隔: %d",
             endtime.c_str(), lessTime.c_str(), heartbeatInterval);

        if (!endtime.empty()) {
            saveExpiryTime(endtime);
        }

        if (endtimeTimestamp > 0) {
            LOGD("心跳到期时间戳: %ld", endtimeTimestamp);
        }

        if (endtime.empty()) {
            return "SUCCESS: 心跳验证成功";
        }
        return "SUCCESS:" + endtime;
    } catch (const std::exception& e) {
        LOGE("解析心跳响应异常: %s, 原始响应: %s", e.what(), response.c_str());
        return "Error: 心跳响应解析失败";
    } catch (...) {
        LOGE("解析心跳响应未知异常，原始响应: %s", response.c_str());
        return "Error: 心跳响应解析失败";
    }
}

std::string cardLogout(const std::string& needle) {
    LOGI("==================== 卡密退出登录开始 ====================");
    LOGI("登录标识: %s", needle.c_str());
    
    // 获取服务器时间戳
    LOGI("步骤1: 获取服务器时间戳...");
    std::string timestamp = getServerTimestampWithFailover();
    if (timestamp.empty()) {
        LOGE("❌ 无法获取服务器时间戳");
        return "Error: 无法获取服务器时间戳";
    }
    LOGI("✅ 服务器时间戳获取成功: %s", timestamp.c_str());
    
    // 获取设备ID（防止异地登录）
    LOGI("步骤2: 获取设备ID...");
    std::string deviceId = getDeviceId();
    LOGI("✅ 设备ID获取成功: %s", deviceId.substr(0, 8).c_str());
    
    // 按照Lua实现进行设备ID加密处理
    LOGI("步骤3: 设备ID加密处理...");
    std::string clientKey = md5Hash(CARD_API_PASSWORD + deviceId + timestamp);
    LOGI("✅ 设备ID加密完成: %s", clientKey.substr(0, 8).c_str());
    
    // 生成请求签名（按照Lua实现：使用加密后的client_key）
    LOGI("步骤4: 生成请求签名...");
    std::string apiPasswordWithKey = CARD_API_PASSWORD + clientKey;
    std::string sign = md5Hash(apiPasswordWithKey + timestamp);
    LOGI("✅ 请求签名生成成功: %s", sign.c_str());
    
    // 构建请求参数
    LOGI("步骤5: 构建请求参数...");
    std::map<std::string, std::string> params = {
        {HTTP_PARAM_NEEDLE, needle},
        {HTTP_PARAM_CENTER_ID, CARD_API_CENTER_ID},
        {HTTP_PARAM_TIMESTAMP, timestamp},
        {HTTP_PARAM_SIGN, sign},
        {HTTP_PARAM_CLIENT_KEY, clientKey}  // 添加client_key参数
    };
    
    // 打印所有请求参数
    LOGI("请求参数详情:");
    for (const auto& param : params) {
        LOGI("  %s = %s", param.first.c_str(), param.second.c_str());
    }
    
    // 执行请求
    LOGI("步骤4: 发送HTTP请求到服务器...");
    LOGI("请求端点: %s", HTTP_API_CARD_LOGOUT);
    std::string response = performRequestWithFailover(HTTP_API_CARD_LOGOUT, params);
    
    if (response.find("Error:") == 0) {
        LOGE("❌ HTTP请求失败: %s", response.c_str());
        return response;
    }
    LOGI("✅ HTTP请求成功，响应长度: %zu", response.length());
    LOGI("服务器响应: %s", response.c_str());
    
    LOGI("==================== 卡密退出登录成功 ====================");
    return "SUCCESS: 退出登录成功";
}

// 新的响应解析
CardLoginResponse parseCardLoginResponse(const std::string& jsonResponse) {
    LOGI("==================== 开始解析卡密登录响应 ====================");
    LOGI("原始响应: %s", jsonResponse.c_str());
    
    CardLoginResponse response;
    response.success = false;
    
    // 检查响应码
    LOGI("步骤1: 检查响应码...");
    if (jsonResponse.find("\"code\":\"1\"") != std::string::npos) {
        LOGI("✅ 响应码为1，登录成功");
        response.success = true;
        
        // 提取data字段中的各个值
        // 这里使用简单的字符串查找，实际项目中应该使用JSON库
        size_t dataStart = jsonResponse.find("\"data\":{");
        if (dataStart != std::string::npos) {
            // 提取type
            size_t typeStart = jsonResponse.find("\"type\":\"", dataStart);
            if (typeStart != std::string::npos) {
                typeStart += 8; // 跳过"type":"
                size_t typeEnd = jsonResponse.find("\"", typeStart);
                if (typeEnd != std::string::npos) {
                    response.type = jsonResponse.substr(typeStart, typeEnd - typeStart);
                }
            }
            
            // 提取endtime
            size_t endtimeStart = jsonResponse.find("\"endtime\":\"", dataStart);
            if (endtimeStart != std::string::npos) {
                endtimeStart += 11; // 跳过"endtime":"
                size_t endtimeEnd = jsonResponse.find("\"", endtimeStart);
                if (endtimeEnd != std::string::npos) {
                    response.endtime = jsonResponse.substr(endtimeStart, endtimeEnd - endtimeStart);
                }
            }
            
            // 提取endtime_timestamp
            size_t timestampStart = jsonResponse.find("\"endtime_timestamp\":", dataStart);
            if (timestampStart != std::string::npos) {
                timestampStart += 20; // 跳过"endtime_timestamp":
                size_t timestampEnd = jsonResponse.find(",", timestampStart);
                if (timestampEnd == std::string::npos) {
                    timestampEnd = jsonResponse.find("}", timestampStart);
                }
                if (timestampEnd != std::string::npos) {
                    std::string timestampStr = jsonResponse.substr(timestampStart, timestampEnd - timestampStart);
                    response.endtime_timestamp = std::stol(timestampStr);
                }
            }
            
            // 提取less_time
            size_t lessTimeStart = jsonResponse.find("\"less_time\":\"", dataStart);
            if (lessTimeStart != std::string::npos) {
                lessTimeStart += 13; // 跳过"less_time":"
                size_t lessTimeEnd = jsonResponse.find("\"", lessTimeStart);
                if (lessTimeEnd != std::string::npos) {
                    response.less_time = jsonResponse.substr(lessTimeStart, lessTimeEnd - lessTimeStart);
                }
            }
            
            // 提取needle
            size_t needleStart = jsonResponse.find("\"needle\":\"", dataStart);
            if (needleStart != std::string::npos) {
                needleStart += 10; // 跳过"needle":"
                size_t needleEnd = jsonResponse.find("\"", needleStart);
                if (needleEnd != std::string::npos) {
                    response.needle = jsonResponse.substr(needleStart, needleEnd - needleStart);
                }
            }
        }
        
        // 提取sign
        size_t signStart = jsonResponse.find("\"sign\":\"");
        if (signStart != std::string::npos) {
            signStart += 8; // 跳过"sign":"
            size_t signEnd = jsonResponse.find("\"", signStart);
            if (signEnd != std::string::npos) {
                response.sign = jsonResponse.substr(signStart, signEnd - signStart);
            }
        }
        
        LOGI("==================== 响应解析完成 ====================");
        LOGI("✅ 解析成功 - 类型: %s", response.type.c_str());
        LOGI("✅ 解析成功 - 到期时间: %s", response.endtime.c_str());
        LOGI("✅ 解析成功 - 剩余时间: %s", response.less_time.c_str());
        LOGI("✅ 解析成功 - 时间戳: %ld", response.endtime_timestamp);
        LOGI("✅ 解析成功 - 登录标识: %s", response.needle.c_str());
        LOGI("✅ 解析成功 - 响应签名: %s", response.sign.c_str());
    } else {
        LOGE("==================== 响应解析失败 ====================");
        LOGE("❌ 卡密登录失败 - 响应码不为1");
        LOGI("完整响应内容: %s", jsonResponse.c_str());
    }
    
    return response;
}

// 解析时间服务响应中的时间戳
std::string parseTimestampFromResponse(const std::string& response) {
    // 简单实现：尝试从响应中提取数字作为时间戳
    // 这是一个基本的实现，可能需要根据具体的时间服务响应格式进行调整
    try {
        // 查找响应中的数字序列
        std::regex timestampRegex("\\d{10}");
        std::smatch match;
        if (std::regex_search(response, match, timestampRegex)) {
            return match[0].str();
        }
    } catch (const std::exception& e) {
        LOGE("解析时间戳异常: %s", e.what());
    }
    return "";
}
