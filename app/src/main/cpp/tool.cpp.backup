// 设置应用名称
void setAppName(const std::string& appName) {
    if (HTTP_PLAINTEXT) {
        g_appName = appName + "dz";
        if(appName == DEFAULT_JSCQ) {
            g_appName = "梁山定制1";
        } else if(appName == "梁山免验证") {
            g_appName = "梁山传奇dz";
        }
    } else {
        if(appName == DEFAULT_GD_NAME) {
            g_appName = DEFAULT_GD_NAME;
        } else {
            g_appName = DEFAULT_APP_NAME;
        }
    }
    LOGI("应用名称已重置为默认值: %s", g_appName.c_str());
}

// 获取应用名称
std::string getAppName() {
    return g_appName;
}

// 自动初始化应用名称（从Android系统获取）
void autoInitAppName(JNIEnv* env, jobject context) {
    if (env == nullptr || context == nullptr) {
        LOGE("autoInitAppName: 无效的JNI环境或Context");
        return;
    }
    
    try {
        // 获取Context类
        jclass contextClass = env->FindClass("android/content/Context");
        if (contextClass == nullptr) {
            LOGE("autoInitAppName: 无法找到Context类");
            return;
        }
        
        // 获取PackageManager
        jmethodID getPackageManagerMethod = env->GetMethodID(contextClass, "getPackageManager", "()Landroid/content/pm/PackageManager;");
        if (getPackageManagerMethod == nullptr) {
            LOGE("autoInitAppName: 无法找到getPackageManager方法");
            env->DeleteLocalRef(contextClass);
            return;
        }
        
        jobject packageManager = env->CallObjectMethod(context, getPackageManagerMethod);
        if (packageManager == nullptr) {
            LOGE("autoInitAppName: 无法获取PackageManager");
            env->DeleteLocalRef(contextClass);
            return;
        }
        
        // 获取包名
        jmethodID getPackageNameMethod = env->GetMethodID(contextClass, "getPackageName", "()Ljava/lang/String;");
        if (getPackageNameMethod == nullptr) {
            LOGE("autoInitAppName: 无法找到getPackageName方法");
            env->DeleteLocalRef(contextClass);
            env->DeleteLocalRef(packageManager);
            return;
        }
        
        jstring packageName = (jstring)env->CallObjectMethod(context, getPackageNameMethod);
        if (packageName == nullptr) {
            LOGE("autoInitAppName: 无法获取包名");
            env->DeleteLocalRef(contextClass);
            env->DeleteLocalRef(packageManager);
            return;
        }
        
        // 获取ApplicationInfo
        jclass packageManagerClass = env->FindClass("android/content/pm/PackageManager");
        if (packageManagerClass == nullptr) {
            LOGE("autoInitAppName: 无法找到PackageManager类");
            env->DeleteLocalRef(contextClass);
            env->DeleteLocalRef(packageManager);
            env->DeleteLocalRef(packageName);
            return;
        }
        
        jmethodID getApplicationInfoMethod = env->GetMethodID(packageManagerClass, 
            "getApplicationInfo", "(Ljava/lang/String;I)Landroid/content/pm/ApplicationInfo;");
        if (getApplicationInfoMethod == nullptr) {
            LOGE("autoInitAppName: 无法找到getApplicationInfo方法");
            env->DeleteLocalRef(contextClass);
            env->DeleteLocalRef(packageManager);
            env->DeleteLocalRef(packageName);
            env->DeleteLocalRef(packageManagerClass);
            return;
        }
        
        jobject appInfo = env->CallObjectMethod(packageManager, getApplicationInfoMethod, packageName, 0);
        if (appInfo == nullptr) {
            LOGE("autoInitAppName: 无法获取ApplicationInfo");
            env->DeleteLocalRef(contextClass);
            env->DeleteLocalRef(packageManager);
            env->DeleteLocalRef(packageName);
            env->DeleteLocalRef(packageManagerClass);
            return;
        }
        
        // 获取应用标签（显示名称）
        jmethodID loadLabelMethod = env->GetMethodID(packageManagerClass, 
            "getApplicationLabel", "(Landroid/content/pm/ApplicationInfo;)Ljava/lang/CharSequence;");
        if (loadLabelMethod == nullptr) {
            LOGE("autoInitAppName: 无法找到getApplicationLabel方法");
            env->DeleteLocalRef(contextClass);
            env->DeleteLocalRef(packageManager);
            env->DeleteLocalRef(packageName);
            env->DeleteLocalRef(packageManagerClass);
            env->DeleteLocalRef(appInfo);
            return;
        }
        
        jobject appLabel = env->CallObjectMethod(packageManager, loadLabelMethod, appInfo);
        if (appLabel == nullptr) {
            LOGE("autoInitAppName: 无法获取应用标签");
            env->DeleteLocalRef(contextClass);
            env->DeleteLocalRef(packageManager);
            env->DeleteLocalRef(packageName);
            env->DeleteLocalRef(packageManagerClass);
            env->DeleteLocalRef(appInfo);
            return;
        }
        
        // 将CharSequence转换为String
        jclass charSequenceClass = env->FindClass("java/lang/CharSequence");
        if (charSequenceClass == nullptr) {
            LOGE("autoInitAppName: 无法找到CharSequence类");
            env->DeleteLocalRef(contextClass);
            env->DeleteLocalRef(packageManager);
            env->DeleteLocalRef(packageName);
            env->DeleteLocalRef(packageManagerClass);
            env->DeleteLocalRef(appInfo);
            env->DeleteLocalRef(appLabel);
            return;
        }
        
        jmethodID toStringMethod = env->GetMethodID(charSequenceClass, "toString", "()Ljava/lang/String;");
        if (toStringMethod == nullptr) {
            LOGE("autoInitAppName: 无法找到toString方法");
            env->DeleteLocalRef(contextClass);
            env->DeleteLocalRef(packageManager);
            env->DeleteLocalRef(packageName);
            env->DeleteLocalRef(packageManagerClass);
            env->DeleteLocalRef(appInfo);
            env->DeleteLocalRef(appLabel);
            env->DeleteLocalRef(charSequenceClass);
            return;
        }
        
        jstring appNameString = (jstring)env->CallObjectMethod(appLabel, toStringMethod);
        
        // 清理资源
        env->DeleteLocalRef(contextClass);
        env->DeleteLocalRef(packageManager);
        env->DeleteLocalRef(packageName);
        env->DeleteLocalRef(packageManagerClass);
        env->DeleteLocalRef(appInfo);
        env->DeleteLocalRef(appLabel);
        env->DeleteLocalRef(charSequenceClass);
        
        if (appNameString != nullptr) {
            const char* appNameStr = env->GetStringUTFChars(appNameString, nullptr);
            if (appNameStr != nullptr) {
                LOGI("🚀 app启动自动初始化 - 获取到应用名称: %s", appNameStr);
                setAppName(std::string(appNameStr));
                env->ReleaseStringUTFChars(appNameString, appNameStr);
            }
            env->DeleteLocalRef(appNameString);
        } else {
            LOGW("autoInitAppName: 无法获取应用名称，使用默认值");
            setAppName(""); // 这会设置为默认值
        }
        
    } catch (const std::exception& e) {
        LOGE("autoInitAppName: C++异常: %s", e.what());
        setAppName(""); // 发生异常时使用默认值
    } catch (...) {
        LOGE("autoInitAppName: 未知异常");
        setAppName(""); // 发生异常时使用默认值
    }
}

// ==================== 增强版域名验证系统 ====================

// 全局变量：存储验证参数
static std::map<std::string, std::string> g_verificationCache;
static std::mutex g_verificationMutex;
static std::atomic<bool> g_verificationInitialized{false};

// 动态密钥生成函数
std::string generateDynamicKey(const std::string& baseKey, const std::string& deviceInfo) {
    // 使用设备信息生成动态密钥
    std::string combined = baseKey + deviceInfo;
    
    // 计算SHA256哈希
    unsigned char hash[SHA256_DIGEST_LENGTH];
    SHA256_CTX sha256;
    SHA256_Init(&sha256);
    SHA256_Update(&sha256, combined.c_str(), combined.length());
    SHA256_Final(hash, &sha256);
    
    // 转换为十六进制字符串
    std::stringstream ss;
    for (int i = 0; i < SHA256_DIGEST_LENGTH; i++) {
        ss << std::hex << std::setw(2) << std::setfill('0') << (int)hash[i];
    }
    
    // 取前32字节作为AES密钥
    return ss.str().substr(0, 32);
}

// 计算SHA256哈希
std::string calculateSHA256(const std::string& input) {
    unsigned char hash[SHA256_DIGEST_LENGTH];
    SHA256_CTX sha256;
    SHA256_Init(&sha256);
    SHA256_Update(&sha256, input.c_str(), input.length());
    SHA256_Final(hash, &sha256);
    
    std::stringstream ss;
    for (int i = 0; i < SHA256_DIGEST_LENGTH; i++) {
        ss << std::hex << std::setw(2) << std::setfill('0') << (int)hash[i];
    }
    return ss.str();
}

// 获取当前时间戳（毫秒）
std::string getCurrentTimestamp() {
    auto now = std::chrono::system_clock::now();
    auto duration = now.time_since_epoch();
    auto millis = std::chrono::duration_cast<std::chrono::milliseconds>(duration).count();
    return std::to_string(millis);
}

// 验证时间戳（防止重放攻击）
bool validateTimestamp(const std::string& timestamp, int maxAgeSeconds = 300) {
    try {
        std::time_t current = std::chrono::system_clock::to_time_t(std::chrono::system_clock::now());
        std::time_t provided = std::stoll(timestamp) / 1000;
        
        double diff = std::difftime(current, provided);
        return std::abs(diff) <= maxAgeSeconds;
    } catch (const std::exception& e) {
        LOGE("时间戳验证异常: %s", e.what());
        return false;
    }
}

// 修复后的多层验证系统
bool performMultiLayerValidation(const std::string& domain, const std::string& deviceId) {
    std::lock_guard<std::mutex> lock(g_verificationMutex);
    
    if (domain.empty()) {
        LOGE("多层验证：域名为空");
        return false;
    }
    
    // 第1层：基础格式验证
    if (domain.length() < 3 || domain.length() > 253) {
        LOGE("多层验证：域名长度异常 - %zu", domain.length());
        return false;
    }
    
    // 检查域名是否包含协议前缀
    if (domain.find("http://") == 0 || domain.find("https://") == 0) {
        LOGE("多层验证：域名不应包含协议前缀");
        return false;
    }
    
    // 检查域名格式（至少包含一个点）
    size_t dotCount = std::count(domain.begin(), domain.end(), '.');
    if (dotCount < 1 || dotCount > 10) {
        LOGE("多层验证：域名格式异常，点数量: %zu", dotCount);
        return false;
    }
    
    // 🔒 新增：域名白名单验证（严格限制只能使用gmcdk.top）
    if (domain != "gmcdk.top") {
        LOGE("🚨 域名白名单验证失败！检测到非法域名: %s", domain.c_str());
        LOGE("🚨 只允许使用域名: gmcdk.top");
        
        // 记录安全威胁
        std::string securityLog = "DOMAIN_WHITELIST_VIOLATION: " + domain + " " + getCurrentTimestamp();
        LOGI("安全日志: %s", securityLog.c_str());
        
        g_verificationCache[domain] = "BLOCKED";
        return false;
    }
    
    LOGI("✅ 域名白名单验证通过: %s", domain.c_str());
    
    // 第2层：域名加密验证（核心验证）
    std::string encryptedDomain = encryptDomainWithAES(domain);
    if (encryptedDomain.empty()) {
        LOGE("多层验证：域名加密失败");
        return false;
    }
    
    // 与预期加密值比较
    bool isValid = (encryptedDomain == EXPECTED_ENCRYPTED_DOMAIN1);
    
    if (isValid) {
        LOGI("多层验证：通过 - 域名加密验证成功");
        
        // 记录成功验证到缓存（使用域名作为key）
        g_verificationCache[domain] = "VALID";
        
        // 定期清理缓存
        if (g_verificationCache.size() > 100) {
            g_verificationCache.clear();
            LOGD("验证缓存已清理");
        }
    } else {
        LOGE("多层验证：失败 - 检测到域名篡改");
        LOGE("验证详情 - 域名: %s", domain.c_str());
        LOGE("验证详情 - 加密结果: %s", encryptedDomain.c_str());
        LOGE("验证详情 - 期望值: %s", EXPECTED_ENCRYPTED_DOMAIN1);
        
        // 记录失败验证到缓存
        g_verificationCache[domain] = "INVALID";
    }
    
    return isValid;
}

