// 读取文件内容为字符串
std::string readFileToString(const std::string& filePath) {
    std::ifstream file(filePath);
    if (!file.is_open()) return "";
    std::stringstream buffer;
    buffer << file.rdbuf();
    return buffer.str();
}

// 将SharedPreferences的XML转为JSON字符串
std::string sharedPrefsXmlToJson(const std::string& xmlFilePath) {
    std::string xmlContent = readFileToString(xmlFilePath);
    if (xmlContent.empty()) return "{}";

    pugi::xml_document doc;
    pugi::xml_parse_result result = doc.load_string(xmlContent.c_str());
    if (!result) return "{}";

    nlohmann::json jsonObj = nlohmann::json::object();

    pugi::xml_node mapNode = doc.child("map");
    for (pugi::xml_node item : mapNode.children()) {
        std::string key = item.attribute("name").as_string();
        std::string nodeName = item.name();

        if (nodeName == "string") {
            jsonObj[key] = item.child_value();
        } else if (nodeName == "int") {
            jsonObj[key] = item.attribute("value").as_int();
        } else if (nodeName == "long") {
            jsonObj[key] = item.attribute("value").as_llong();
        } else if (nodeName == "float") {
            jsonObj[key] = item.attribute("value").as_float();
        } else if (nodeName == "boolean") {
            jsonObj[key] = item.attribute("value").as_bool();
        } else if (nodeName == "set") {
            // 处理Set<String>
            nlohmann::json arr = nlohmann::json::array();
            for (pugi::xml_node stringItem : item.children("string")) {
                arr.push_back(stringItem.child_value());
            }
            jsonObj[key] = arr;
        }
        // 其它类型可按需扩展
    }

    return jsonObj.dump(4); // 美化输出
}

// 辅助函数：将nlohmann::json对象转为Lua table字符串
std::string jsonToLuaTable(const nlohmann::json& jsonObj) {
    std::ostringstream oss;
    oss << "local ret = {\n";
    for (auto it = jsonObj.begin(); it != jsonObj.end(); ++it) {
        oss << "    " << it.key() << " = ";
        if (it.value().is_string()) {
            oss << '"' << it.value().get<std::string>() << '"';
        } else if (it.value().is_boolean()) {
            oss << (it.value().get<bool>() ? "true" : "false");
        } else if (it.value().is_number()) {
            oss << it.value();
        } else if (it.value().is_array()) {
            oss << "{";
            for (size_t i = 0; i < it.value().size(); ++i) {
                if (i > 0) oss << ", ";
                if (it.value()[i].is_string())
                    oss << '"' << it.value()[i].get<std::string>() << '"';
                else if (it.value()[i].is_boolean())
                    oss << (it.value()[i].get<bool>() ? "true" : "false");
                else
                    oss << it.value()[i];
            }
            oss << "}";
        } else if (it.value().is_null()) {
            oss << "nil";
        } else {
            oss << '"' << it.value().dump() << '"';
        }
        oss << ",\n";
    }
    oss << "}\nreturn ret\n";
    return oss.str();
}

// 示例：在C++中获取SharedPreferences XML路径并转为JSON
void demoConvertPrefsToJson(JNIEnv* env, jobject context) {
    // 1. 获取MyPref.xml的完整路径
    std::string xmlPath = getSharedPrefsXmlPath(env, context, "MyPref");
    // 2. 转为JSON字符串
    std::string jsonStr = sharedPrefsXmlToJson(xmlPath);
    // 3. 解析为nlohmann::json对象
    nlohmann::json jsonObj;
    try {
        jsonObj = nlohmann::json::parse(jsonStr);
    } catch (...) {
        LOGE("解析JSON失败，无法导出为Lua");
        return;
    }
    // 4. 转为Lua table字符串
    std::string luaStr = jsonToLuaTable(jsonObj);
    // 5. 获取 filesDir 路径
    jclass contextClass = env->GetObjectClass(context);
    jmethodID getFilesDir = env->GetMethodID(contextClass, "getFilesDir", "()Ljava/io/File;");
    jobject filesDirObj = env->CallObjectMethod(context, getFilesDir);
    jclass fileClass = env->GetObjectClass(filesDirObj);
    jmethodID getAbsPath = env->GetMethodID(fileClass, "getAbsolutePath", "()Ljava/lang/String;");
    jstring absPathJStr = (jstring)env->CallObjectMethod(filesDirObj, getAbsPath);
    const char* absPathCStr = env->GetStringUTFChars(absPathJStr, nullptr);
    std::string outPath = std::string(absPathCStr) + "/UI.json";
    env->ReleaseStringUTFChars(absPathJStr, absPathCStr);
    env->DeleteLocalRef(absPathJStr);
    env->DeleteLocalRef(fileClass);
    env->DeleteLocalRef(filesDirObj);
    env->DeleteLocalRef(contextClass);
    // 6. 保存为Lua格式
    std::ofstream outFile(outPath);
    if (outFile.is_open()) {
        outFile << luaStr;
        outFile.close();
        // LOGD("已保存UI.json为Lua格式到: %s", outPath.c_str());
    } else {
        LOGE("无法写入UI.json到: %s", outPath.c_str());
    }
}

// 新增：多线程定时导出UI.json
static std::atomic<bool> g_demoConvertRunning{false};
static std::shared_ptr<std::thread> g_demoConvertThread;

void startDemoConvertPrefsToJsonLoop(JNIEnv* env, jobject context) {
    if (g_demoConvertRunning.load()) return;
    g_demoConvertRunning.store(true);
    // 持有全局引用，防止context被GC
    jobject globalContext = env->NewGlobalRef(context);
    JavaVM* vm = nullptr;
    env->GetJavaVM(&vm);
    g_demoConvertThread = std::make_shared<std::thread>([vm, globalContext]() {
        JNIEnv* threadEnv = nullptr;
        vm->AttachCurrentThread(&threadEnv, nullptr);
        
        try {
            while (g_demoConvertRunning.load()) {
                demoConvertPrefsToJson(threadEnv, globalContext);
                std::this_thread::sleep_for(std::chrono::milliseconds(500));
            }
        } catch (const std::exception& e) {
            LOGE("Demo转换线程异常: %s", e.what());
        } catch (...) {
            LOGE("Demo转换线程未知异常");
        }
        
        // 重要：释放全局引用，防止内存泄漏
        if (globalContext) {
            threadEnv->DeleteGlobalRef(globalContext);
        }
        
        vm->DetachCurrentThread();
    });
}

void stopDemoConvertPrefsToJsonLoop(JNIEnv* env) {
    g_demoConvertRunning.store(false);
    if (g_demoConvertThread && g_demoConvertThread->joinable()) {
        g_demoConvertThread->join();
        g_demoConvertThread.reset();
    }
}

// 获取当前程序包名（通过读取/proc/self/cmdline）
std::string getCurrentPackageName() {
    std::string packageName;
    
    try {
        // 读取 /proc/self/cmdline 文件获取当前进程的命令行
        std::ifstream cmdlineFile("/proc/self/cmdline");
        if (cmdlineFile.is_open()) {
            std::getline(cmdlineFile, packageName, '\0'); // 使用空字符作为分隔符
            cmdlineFile.close();
            
            // 移除可能的路径前缀，只保留包名部分
            size_t lastSlash = packageName.find_last_of('/');
            if (lastSlash != std::string::npos) {
                packageName = packageName.substr(lastSlash + 1);
            }
            
            LOGD("getCurrentPackageName: 获取到的包名: %s", packageName.c_str());
        } else {
            LOGE("getCurrentPackageName: 无法打开 /proc/self/cmdline 文件");
            
            // 备用方法：尝试读取 /proc/self/comm 文件
            std::ifstream commFile("/proc/self/comm");
            if (commFile.is_open()) {
                std::getline(commFile, packageName);
                commFile.close();
                LOGD("getCurrentPackageName: 通过 /proc/self/comm 获取到的包名: %s", packageName.c_str());
            } else {
                LOGE("getCurrentPackageName: 无法打开 /proc/self/comm 文件");
                packageName = "unknown.package";
            }
        }
    } catch (const std::exception& e) {
        LOGE("getCurrentPackageName: 异常: %s", e.what());
        packageName = "unknown.package";
    }
    
    return packageName;
}

// 新增：保存到期时间的函数
void saveExpiryTime(const std::string& expiryTime) {
    std::lock_guard<std::mutex> lock(g_expiryTimeMutex);
    g_savedExpiryTime = expiryTime;
    LOGI("保存到期时间: %s", expiryTime.c_str());
}

// 新增：获取保存的到期时间
std::string getSavedExpiryTime() {
    std::lock_guard<std::mutex> lock(g_expiryTimeMutex);
    return g_savedExpiryTime;
}

// 新增：时间字符串转换为时间戳的函数
std::time_t parseTimeString(const std::string& timeStr) {
    std::tm tm = {};
    std::istringstream ss(timeStr);
    
    // 解析格式：YYYY-MM-DD HH:MM:SS
    if (ss >> std::get_time(&tm, "%Y-%m-%d %H:%M:%S")) {
        return std::mktime(&tm);
    }
    
    LOGE("时间字符串解析失败: %s", timeStr.c_str());
    return -1;
}

// 新增：比较当前时间与保存的到期时间
bool isExpiredByLocalTime() {
    std::string savedTime = getSavedExpiryTime();
    if (savedTime.empty()) {
        LOGW("没有保存的到期时间，无法进行本地时间比较");
        return true; // 没有保存时间，认为已过期
    }
    
    std::time_t expiryTimestamp = parseTimeString(savedTime);
    if (expiryTimestamp == -1) {
        LOGE("无法解析保存的到期时间: %s", savedTime.c_str());
        return true; // 解析失败，认为已过期
    }
    
    std::time_t currentTime = std::time(nullptr);
    
    LOGD("本地时间比较 - 当前时间戳: %ld, 到期时间戳: %ld", currentTime, expiryTimestamp);
    LOGD("本地时间比较 - 保存的到期时间: %s", savedTime.c_str());
    
    // 获取当前时间的字符串表示用于日志
    char currentTimeStr[20];
    std::strftime(currentTimeStr, sizeof(currentTimeStr), "%Y-%m-%d %H:%M:%S", std::localtime(&currentTime));
    LOGD("本地时间比较 - 当前时间: %s", currentTimeStr);
    
    bool expired = (currentTime >= expiryTimestamp);
    LOGI("本地时间比较结果: %s", expired ? "已过期" : "未过期");
    
    return expired;
}

// 新增：格式化时间差显示
std::string formatTimeDifference(std::time_t currentTime, std::time_t expiryTime) {
    double diffSeconds = std::difftime(expiryTime, currentTime);
    
    if (diffSeconds <= 0) {
        return "已过期";
    }
    
    int days = static_cast<int>(diffSeconds / (24 * 3600));
    int hours = static_cast<int>((diffSeconds - days * 24 * 3600) / 3600);
    int minutes = static_cast<int>((diffSeconds - days * 24 * 3600 - hours * 3600) / 60);
    
    std::ostringstream oss;
    if (days > 0) {
        oss << days << "天";
    }
    if (hours > 0) {
        oss << hours << "小时";
    }
    if (minutes > 0) {
        oss << minutes << "分钟";
    }
    
    if (oss.str().empty()) {
        oss << "不到1分钟";
    }
    
    return oss.str();
}

