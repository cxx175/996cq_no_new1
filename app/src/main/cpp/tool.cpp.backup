// 统一处理HTTP响应的模板函数
std::string processHttpResponse(const std::string& response, long response_code, const std::string& operation) {
    // 1. 检查HTTP响应码
    if (response_code != 200) {
        LOGE("HTTP响应码异常: %ld，操作: %s，内容: %s", response_code, operation.c_str(), response.c_str());
        return "";
    }
    
    // 2. 自动解密响应内容
    std::string decryptedResponse = response;
#ifndef NO_OPENSSL
    if (response.find("\"msg\":\"") != std::string::npos) {
        LOGD("检测到加密响应，开始解密，操作: %s", operation.c_str());
        decryptedResponse = decryptPostDataWithAES(response);
        if (decryptedResponse.empty()) {
            LOGE("响应解密失败，操作: %s，原始内容: %s", operation.c_str(), response.c_str());
            return "";
        }
        LOGD("响应解密成功，操作: %s", operation.c_str());
    } else {
        LOGD("响应未加密，直接使用，操作: %s", operation.c_str());
    }
#else
    LOGW("OpenSSL未启用，无法解密响应，操作: %s", operation.c_str());
#endif
    
    return decryptedResponse;
}

